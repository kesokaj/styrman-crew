#!/usr/bin/env bash
# styrman-host-backup — whole-state restic backup of /var/lib/styrman to GCS
# (operator decision 2026-08-29/30; the DISASTER-RECOVERY layer above the
# in-app per-project backups, ADR-044). Committed under deploy/backup/ and
# installed by host-setup.sh (R11: a reinstall must recreate this layer —
# 2026-08-30 review, blocking).
#
# Prereqs (root-only, NEVER in the repo or inside /var/lib/styrman):
#   /etc/styrman/backup-sa.json  — GCS service-account key (objectAdmin on
#                                  the bucket only)
#   /etc/styrman/restic-pw       — restic repo password (ALSO store it in a
#                                  password manager: without it the backups
#                                  are unreadable after host loss)
#   one-time: `restic init` against the repository (host-setup.sh prints a
#   copy-pasteable command). /etc/styrman itself is created by host-setup.sh.
# The baked-in defaults target the ORIGINAL deployment's GCP project/bucket —
# on ANY other host /etc/styrman/backup.env MUST redefine GOOGLE_PROJECT and
# RESTIC_REPOSITORY=gs:<your-bucket>:/ (it is not optional there).
set -euo pipefail
# Defaults FIRST, then the override file, then self-defaulting exports — so
# /etc/styrman/backup.env may override ANY of these (2026-08-30 audit; note
# restic's GCS backend reads GOOGLE_PROJECT_ID, not GOOGLE_PROJECT — it is
# only consulted when restic must CREATE the bucket).
export GOOGLE_PROJECT_ID=driven-eft-h4it
export RESTIC_REPOSITORY=gs:styrman-crew-backups-driven-eft-h4it:/
STATE_DIR=/var/lib/styrman
[ -f /etc/styrman/backup.env ] && . /etc/styrman/backup.env
export GOOGLE_APPLICATION_CREDENTIALS="${GOOGLE_APPLICATION_CREDENTIALS:-/etc/styrman/backup-sa.json}"
export RESTIC_PASSWORD_FILE="${RESTIC_PASSWORD_FILE:-/etc/styrman/restic-pw}"
# NOTE: StateDir/backups IS included (2026-08-30 reader review): a DELETED
# project's in-app archives are the ONLY copy of that project — excluding
# them broke the "backups outlive their project" promise across host loss.
# Only the reproducible per-project docker disks are excluded.
restic backup "${STATE_DIR}" \
  --exclude "${STATE_DIR}/homes/*/p/*/.dockerd" \
  --tag styrman-state
restic forget --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune
