#!/usr/bin/env bash
# styrman-ctl — the one front door to a styrman host (plan
# .agents/docs/plans/2026-09-11-installer-ctl.md).
#
#   sudo deploy/styrman-ctl                 menu
#   sudo deploy/styrman-ctl status [--json] what is installed, deployed, running
#   sudo deploy/styrman-ctl install …       (Phase 2)  host-setup.sh + guided .env + bring-up + auto-update offer
#   sudo deploy/styrman-ctl update …        (Phase 3)  one auto-updater tick; --setup; --redeploy
#   sudo deploy/styrman-ctl edit …          (Phase 3)  .env editor that re-applies
#   sudo deploy/styrman-ctl uninstall …     (Phase 4)  three levels, typed confirmations
#   deploy/styrman-ctl help
#
# WRAPS the existing scripts — deploy/host-setup.sh, deploy/firewall/install.sh,
# deploy/update/styrman-update, deploy/docker-compose.yml — and never re-implements
# them. Every side effect goes through run(), so --dry-run prints the exact
# plan ("+ cmd" lines) and executes nothing; that plan is what the Go test
# (internal/config/styrman_ctl_test.go) asserts, with every path below pointed
# at a scratch prefix (ADR-052) and fake tools on PATH.
set -euo pipefail
shopt -s inherit_errexit

# ─── Paths (env-overridable for tests; the defaults are what host-setup.sh and the units pin) ───
STATE_DIR="${STYRMAN_STATE_DIR:-/var/lib/styrman}"
DEPLOY_DIR="${STYRMAN_DEPLOY_DIR:-/opt/styrman}"
ETC_DIR="${STYRMAN_ETC_DIR:-/etc/styrman}"
UNIT_DIR="${STYRMAN_UNIT_DIR:-/etc/systemd/system}"
# shellcheck disable=SC2034  # used by uninstall (plan phase 4)
BIN_DIR="${STYRMAN_BIN_DIR:-/usr/local/bin}"
# shellcheck disable=SC2034
SBIN_DIR="${STYRMAN_SBIN_DIR:-/usr/local/sbin}"
# shellcheck disable=SC2034
TMPFILES_DIR="${STYRMAN_TMPFILES_DIR:-/etc/tmpfiles.d}"
KATA_DIR="${STYRMAN_KATA_DIR:-/opt/kata}"
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# The checkout's .env (host-setup.sh 5b scaffolds it beside docker-compose.yml);
# overridable so the tests never write into the real checkout.
ENV_FILE="${STYRMAN_ENV_FILE:-${REPO}/deploy/.env}"
OPERATOR="${SUDO_USER:-}"
MUST_FILL="BASE_DOMAIN GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET CLOUDFLARE_API_TOKEN ADMIN_EMAIL STYRMAN_ALLOWED_EMAILS"
CLONE_ENV="${DEPLOY_DIR}/deploy/.env"
# shellcheck disable=SC2034  # used by uninstall (plan phase 4)
UNITS=(styrman-firewall.service styrman-firewall.timer styrman-update.service styrman-update.timer)
DRY=0
YES=0

log()  { echo "==> $*"; }
warn() { echo "==> WARNING: $*" >&2; }
die()  { echo "styrman-ctl: ERROR $*" >&2; exit 1; }
# Every side effect goes through run(): --dry-run prints and does nothing.
run()  { if [ "${DRY}" = 1 ]; then echo "+ $*"; else "$@"; fi; }
need_root() { [ "${DRY}" = 1 ] || [ "$(id -u)" = 0 ] || die "run as root (sudo), or pass --dry-run"; }

# ─── Prompts ────────────────────────────────────────────────────────────────
# ask VAR "prompt" "default" [secret]: reads from the terminal, never from a
# pipe; under --yes (or with no terminal) the default is taken, and an empty
# default is an error rather than a hang.
# has_tty: can /dev/tty actually be OPENED (a permission bit says nothing
# under systemd, cron or go test, where the device exists but no terminal is
# attached).
has_tty() { ( : < /dev/tty ) 2>/dev/null; }
# Its own locals carry underscores: `printf -v "${var}"` assigns by NAME and
# would otherwise land on a same-named local here instead of the caller's.
ask() {
    local _var="$1" _prompt="$2" _default="${3:-}" _secret="${4:-}" _v=""
    if [ "${YES}" = 1 ] || ! has_tty; then
        [ -n "${_default}" ] || die "no value for ${_prompt} (non-interactive; pass it explicitly)"
        printf -v "${_var}" '%s' "${_default}"
        return 0
    fi
    local _shown="${_default}"
    [ -n "${_secret}" ] && [ -n "${_default}" ] && _shown="********"
    if [ -n "${_secret}" ]; then
        read -rs -p "${_prompt}${_shown:+ [${_shown}]}: " _v < /dev/tty; echo
    else
        read -r -p "${_prompt}${_shown:+ [${_shown}]}: " _v < /dev/tty
    fi
    [ -n "${_v}" ] || _v="${_default}"
    printf -v "${_var}" '%s' "${_v}"
}

# confirm_word WORD "why": the operator types the exact word; --confirm WORD
# satisfies it unattended. Anything else aborts with nothing changed.
CONFIRM_GIVEN=""
confirm_word() {
    local word="$1" why="$2" typed=""
    if [ -n "${CONFIRM_GIVEN}" ]; then
        [ "${CONFIRM_GIVEN}" = "${word}" ] || die "--confirm ${CONFIRM_GIVEN} does not match the required word — aborted, nothing changed"
        return 0
    fi
    has_tty || die "no terminal to confirm on; pass --confirm ${word} to proceed unattended"
    echo "${why}"
    read -r -p "Type ${word} to continue: " typed < /dev/tty
    [ "${typed}" = "${word}" ] || die "aborted, nothing changed"
}

# ─── .env helpers ───────────────────────────────────────────────────────────
is_key() { [[ "$1" =~ ^[A-Z][A-Z0-9_]*$ ]]; }
env_get() { # env_get FILE KEY → value ('' if absent); the LAST assignment wins, like compose
    local file="$1" key="$2"
    is_key "${key}" || die "not a key: ${key}"
    [ -f "${file}" ] || return 0
    # The key travels as an awk VARIABLE and is matched literally — never
    # interpolated into a program (security review: a key with a slash
    # changed a sed program; with GNU sed's e flag that is command execution).
    awk -v k="${key}" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2) } END { if (v != "") print v; else if (found) print ""; }' "${file}"
}
# env_set FILE KEY VALUE: replaces the key's line or appends one; atomic
# (temp + mv in the same directory), mode 600, owner kept; refuses a
# symlinked file and a value with a newline (it would smuggle a second key).
env_set() {
    local file="$1" key="$2" value="$3" tmp dir
    [ -L "${file}" ] && die "refusing to write ${file}: it is a symlink"
    [ -f "${file}" ] || die "no such file: ${file}"
    # No newline and no backslash: a newline smuggles a second assignment,
    # and a backslash would let an escape sequence become one downstream
    # (security review: awk -v decoded "\\n" into a real newline).
    case "${value}" in *$'\n'*) die "refusing a value with a newline for ${key}" ;; *\\*) die "refusing a value with a backslash for ${key}" ;; esac
    is_key "${key}" || die "not a key: ${key}"
    # Dry run: the plan names the write and nothing touches the directory
    # (not even a temp file).
    if [ "${DRY}" = 1 ]; then echo "+ env_set ${file} ${key}"; return 0; fi
    dir="$(dirname "${file}")"
    tmp="$(mktemp "${dir}/.env.XXXXXX")"
    if grep -q "^${key}=" "${file}"; then
        # Replace every assignment of the key with one line, keep the rest.
        # The value reaches awk through the ENVIRONMENT, which awk never
        # escape-processes (unlike -v).
        V="${value}" awk -v k="${key}" 'BEGIN{done=0} index($0,k"=")==1 {if(!done){print k"=" ENVIRON["V"]; done=1}; next} {print}' "${file}" > "${tmp}"
    else
        cat "${file}" > "${tmp}"
        printf '%s=%s\n' "${key}" "${value}" >> "${tmp}"
    fi
    chmod 600 "${tmp}"
    chown --reference="${file}" "${tmp}" 2>/dev/null || true
    mv -f "${tmp}" "${file}"
}

# ─── Validation: one rule per key of .env.example ───────────────────────────
COMPUTED_KEYS="STYRMAN_UID STYRMAN_GID DOCKER_GID STYRMAN_USER STYRMAN_INGRESS_TOKEN STYRMAN_JWT_KEY"
# shellcheck disable=SC2034  # masked by edit (plan phase 3)
SECRET_KEYS="GOOGLE_CLIENT_SECRET CLOUDFLARE_API_TOKEN STYRMAN_INGRESS_TOKEN STYRMAN_JWT_KEY"
# The literal reference .env.example's scaffold writes for SUPERADMINS.
# shellcheck disable=SC2016
SUPERADMINS_REF='${STYRMAN_ALLOWED_EMAILS}'
is_hostname() { [[ "$1" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)*[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] && [ "${#1}" -le 253 ]; }
is_label()    { [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; }
is_email()    { [[ "$1" =~ ^[^[:space:]@,]+@[^[:space:]@,]+\.[^[:space:]@,]+$ ]]; }
is_email_list() { local IFS=, e; for e in $1; do e="${e// /}"; [ -n "${e}" ] || return 1; is_email "${e}" || return 1; done; [ -n "$1" ]; }
is_duration() { [[ "$1" =~ ^([0-9]+(ns|us|ms|s|m|h))+$ ]]; }
is_port() { [[ "$1" =~ ^[0-9]{1,5}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
is_octet() { [[ "$1" =~ ^[0-9]{1,3}$ ]] && [ "$1" -le 255 ]; }
is_loopback_addr() {
    local a b c port
    if [[ "$1" =~ ^127\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3}):([0-9]{1,5})$ ]]; then
        # Copy the groups first: each helper's own =~ rewrites BASH_REMATCH.
        a="${BASH_REMATCH[1]}"; b="${BASH_REMATCH[2]}"; c="${BASH_REMATCH[3]}"; port="${BASH_REMATCH[4]}"
        is_octet "${a}" && is_octet "${b}" && is_octet "${c}" && is_port "${port}"
    elif [[ "$1" =~ ^\[::1\]:([0-9]{1,5})$ ]]; then
        port="${BASH_REMATCH[1]}"
        is_port "${port}"
    else
        return 1
    fi
}
# validate KEY VALUE → 0, or 1 with the rule on stderr.
validate() {
    local key="$1" v="$2" ok=1
    case " ${COMPUTED_KEYS} " in *" ${key} "*) echo "${key} is computed by host-setup.sh — re-run install" >&2; return 1 ;; esac
    case "${key}" in
        BASE_DOMAIN) is_hostname "${v}" && ok=0 ;;
        STYRMAN_PUBLIC_DOMAIN|STYRMAN_PRIVATE_DOMAIN) { [ -z "${v}" ] || is_hostname "${v}"; } && ok=0 ;;
        STYRMAN_HOSTNAME) is_label "${v}" && ok=0 ;;
        AUTH_DOMAIN|SHELL_DOMAIN|APPS_DOMAIN) { [ -z "${v}" ] || is_label "${v}"; } && ok=0 ;;
        GOOGLE_CLIENT_ID|GOOGLE_CLIENT_SECRET|CLOUDFLARE_API_TOKEN) [[ "${v}" =~ ^[^[:space:]]+$ ]] && ok=0 ;;
        ADMIN_EMAIL) is_email "${v}" && ok=0 ;;
        STYRMAN_ALLOWED_EMAILS) is_email_list "${v}" && ok=0 ;;
        SUPERADMINS) { [ "${v}" = "${SUPERADMINS_REF}" ] || is_email_list "${v}"; } && ok=0 ;;
        STYRMAN_IDLE_TIMEOUT) is_duration "${v}" && ok=0 ;;
        STYRMAN_TRANSCRIPT_TTL) { [ "${v}" = 0 ] || is_duration "${v}"; } && ok=0 ;;
        STYRMAN_BROKER_ADDR) { [ -z "${v}" ] || [[ "${v}" =~ ^(:|[a-z0-9.-]+:)[0-9]{1,5}$ ]]; } && ok=0 ;;
        DEFAULT_RPS) { [ -z "${v}" ] || [[ "${v}" =~ ^[0-9]+$ ]]; } && ok=0 ;;
        CADDY_ADMIN) { [ -z "${v}" ] || is_loopback_addr "${v}"; } && ok=0 ;;
        STYRMAN_IMAGE) [ -z "${v}" ] && ok=0 ;;
        *) echo "unknown key ${key}: edit the file by hand" >&2; return 1 ;;
    esac
    if [ "${ok}" != 0 ]; then
        case "${key}" in
            BASE_DOMAIN|STYRMAN_PUBLIC_DOMAIN|STYRMAN_PRIVATE_DOMAIN) echo "${key}: not a hostname (labels of a-z 0-9 -, dots)" >&2 ;;
            STYRMAN_HOSTNAME|AUTH_DOMAIN|SHELL_DOMAIN|APPS_DOMAIN) echo "${key}: one DNS label (a-z 0-9 -, up to 63)" >&2 ;;
            GOOGLE_CLIENT_ID|GOOGLE_CLIENT_SECRET|CLOUDFLARE_API_TOKEN) echo "${key}: must be non-empty without whitespace" >&2 ;;
            ADMIN_EMAIL) echo "${key}: one e-mail address" >&2 ;;
            STYRMAN_ALLOWED_EMAILS|SUPERADMINS) echo "${key}: comma-separated e-mail addresses" >&2 ;;
            STYRMAN_IDLE_TIMEOUT|STYRMAN_TRANSCRIPT_TTL) echo "${key}: a Go duration such as 8h or 720h" >&2 ;;
            STYRMAN_BROKER_ADDR) echo "${key}: ':8091' or host:port, or empty" >&2 ;;
            DEFAULT_RPS) echo "${key}: an integer, or empty" >&2 ;;
            CADDY_ADMIN) echo "${key}: empty, or a LOOPBACK IP literal with a port (a name makes caddy refuse to start)" >&2 ;;
            STYRMAN_IMAGE) echo "${key}: must stay empty in production (a mutable tag would re-pin every project)" >&2 ;;
        esac
        return 1
    fi
    return 0
}

# ─── Path guard: the ONLY way a delete target is accepted ───────────────────
# guard_path PATH: canonical, absolute, at least two components, not a
# symlink, and exactly one of the configured trees. Everything that deletes
# goes through it (ADR-052; the firewall installer's BUG-009 rule).
guard_path() {
    local p="$1" real
    real="$(realpath -m -- "${p}")"
    [ "${real}" = "/" ] && { echo "refusing ${p}: it is /" >&2; return 1; }
    [[ "${real}" =~ ^/[^/]+/[^/]+ ]] || { echo "refusing ${p}: a single path component" >&2; return 1; }
    # Canonical as GIVEN: any symlink component (the leaf included) or a
    # `..` makes realpath differ from the literal path, and a delete must
    # never be resolved through a link (BUG-009's rule).
    [ "${real}" = "${p}" ] || { echo "refusing ${p}: not canonical (a symlink or .. in the path)" >&2; return 1; }
    [ -d "${p}" ] || { echo "refusing ${p}: not an existing directory" >&2; return 1; }
    local allowed
    for allowed in "${STATE_DIR}" "${DEPLOY_DIR}" "${ETC_DIR}"; do
        [ "${p}" = "${allowed}" ] && return 0
    done
    echo "refusing ${p}: not one of the configured styrman trees" >&2
    return 1
}

# ─── Status ─────────────────────────────────────────────────────────────────
have() { command -v "$1" >/dev/null 2>&1; }
container_field() { docker inspect -f "$2" "$1" 2>/dev/null || true; }
unit_state() { # unit_state NAME → "enabled/active" style words
    local en ac
    en="$(systemctl is-enabled "$1" 2>/dev/null || true)"; ac="$(systemctl is-active "$1" 2>/dev/null || true)"
    echo "${en:-absent}/${ac:-inactive}"
}
chain_rules() { # chain_rules CHAIN → number of -A rules, or "absent"
    local n
    if have iptables && iptables -S "$1" >/dev/null 2>&1; then n="$(iptables -S "$1" 2>/dev/null | grep -c '^-A' || true)"; echo "${n:-0}"; else echo absent; fi
}
deployed_version() { # from the updater's state, else the running server image tag
    local v=""
    [ -f "${ETC_DIR}/update/deployed-version" ] && v="$(cat "${ETC_DIR}/update/deployed-version" 2>/dev/null || true)"
    if [ -z "${v}" ]; then v="$(container_field styrman-server '{{.Config.Image}}')"; v="${v##*:}"; fi
    printf '%s' "${v}"
}
# printable: what a file, a git tag or a container label contributed to the
# screen — control bytes stripped (a hostile deployed-version or tag must
# not drive the terminal).
printable() { printf '%s' "$1" | tr -d '\000-\037\177'; }
json_str() {
    if command -v python3 >/dev/null 2>&1; then
        python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"
    else
        local v; v="$(printable "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
        printf '"%s"' "${v}"
    fi
}

cmd_status() {
    local as_json=0
    while [ $# -gt 0 ]; do case "$1" in --json) as_json=1; shift ;; *) die "status: unknown flag $1" ;; esac; done
    need_root
    local host; host="$(printable "$(hostname 2>/dev/null || uname -n)")"
    local installed=0
    # An `if`, not a bare `a || b && c` list: under set -e a list whose last
    # command fails ends the script.
    if [ -f "${UNIT_DIR}/styrman-update.service" ] || [ -f "${UNIT_DIR}/styrman-firewall.service" ] || [ -n "$(container_field styrman-server '{{.Id}}')" ]; then
        installed=1
    fi
    # server
    local health server_img caddy_img running url base hn
    health="$(printable "$(container_field styrman-server '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}')")"
    server_img="$(printable "$(container_field styrman-server '{{.Config.Image}}')")"
    caddy_img="$(printable "$(container_field styrman-caddy '{{.Config.Image}}')")"
    running="$(container_field styrman-server '{{.State.Running}}')"
    # The checkout may carry no .env at all (production deploys from the
    # clone): read whichever copy exists, the checkout's first.
    local envsrc="${ENV_FILE}"; [ -f "${envsrc}" ] || envsrc="${CLONE_ENV}"
    base="$(env_get "${envsrc}" BASE_DOMAIN)"; hn="$(env_get "${envsrc}" STYRMAN_HOSTNAME)"
    url=""; [ -n "${base}" ] && url="https://${hn:-styrman}.${base}"
    # deployed
    local dver dsha fver
    dver="$(printable "$(deployed_version)")"
    dsha="$(printable "$(cat "${ETC_DIR}/update/deployed-sha" 2>/dev/null || true)")"
    fver="$(printable "$(cat "${ETC_DIR}/update/failed-version" 2>/dev/null || true)")"
    # updater + clone
    local clone_sha="" clone_tag="" envs_differ=0
    if [ -d "${DEPLOY_DIR}/.git" ]; then
        clone_sha="$(printable "$(git -C "${DEPLOY_DIR}" rev-parse --short HEAD 2>/dev/null || true)")"
        clone_tag="$(printable "$(git -C "${DEPLOY_DIR}" describe --tags --exact-match 2>/dev/null || true)")"
        if [ -f "${CLONE_ENV}" ] && [ -f "${ENV_FILE}" ] && ! cmp -s "${CLONE_ENV}" "${ENV_FILE}"; then envs_differ=1; fi
    fi
    # units + firewall
    local u_fw_s u_fw_t u_up_s u_up_t fwd in4
    u_fw_s="$(unit_state styrman-firewall.service)"; u_fw_t="$(unit_state styrman-firewall.timer)"
    u_up_s="$(unit_state styrman-update.service)";   u_up_t="$(unit_state styrman-update.timer)"
    fwd="$(chain_rules STYRMAN-FWD)"; in4="$(chain_rules STYRMAN-IN)"
    # projects + host
    local vms dirs disk dockerv katav operator
    # `|| true` on each pipeline: under pipefail a failing docker/find (no
    # daemon, no dir) would otherwise end the script via set -e.
    vms="$(docker ps -q --filter label=styrman.managed=true 2>/dev/null | wc -l | tr -d ' ' || true)"
    dirs="$(find "${STATE_DIR}/projects" -mindepth 2 -maxdepth 2 -type d 2>/dev/null | wc -l | tr -d ' ' || true)"
    disk="$(timeout 20 du -sh "${STATE_DIR}" 2>/dev/null | cut -f1 || true)"; disk="${disk:-?}"
    dockerv="$(docker version --format '{{.Server.Version}}' 2>/dev/null || true)"
    katav="$("${KATA_DIR}/bin/kata-runtime" --version 2>/dev/null | head -1 | awk '{print $NF}' || true)"
    operator="$(stat -c %U "${STATE_DIR}" 2>/dev/null || true)"
    # verdict: 0 green, 1 degraded, 2 not installed
    local rc=0
    [ "${installed}" = 1 ] || rc=2
    if [ "${rc}" = 0 ]; then
        [ "${health}" = healthy ] || rc=1
        [ -z "${fver}" ] || rc=1
        [[ "${u_fw_s}" == enabled/* ]] || rc=1
        [[ "${u_fw_t}" == enabled/* ]] || rc=1
        [ "${fwd}" != absent ] || rc=1
    fi
    if [ "${as_json}" = 1 ]; then
        printf '{"host":%s,"installed":%s,"server":{"health":%s,"image":%s,"caddy":%s,"running":%s,"url":%s},"deployed":{"version":%s,"sha":%s,"failed":%s},"updater":{"service":%s,"timer":%s,"clone_sha":%s,"clone_tag":%s,"env_copies_differ":%s},"firewall":{"service":%s,"timer":%s,"fwd_rules":%s,"in_rules":%s},"projects":{"running":%s,"dirs":%s,"disk":%s},"host_tools":{"docker":%s,"kata":%s,"operator":%s},"exit":%s}\n' \
            "$(json_str "${host}")" "$([ "${installed}" = 1 ] && echo true || echo false)" \
            "$(json_str "${health}")" "$(json_str "${server_img}")" "$(json_str "${caddy_img}")" "$([ "${running}" = true ] && echo true || echo false)" "$(json_str "${url}")" \
            "$(json_str "${dver}")" "$(json_str "${dsha}")" "$(json_str "${fver}")" \
            "$(json_str "${u_up_s}")" "$(json_str "${u_up_t}")" "$(json_str "${clone_sha}")" "$(json_str "${clone_tag}")" "$([ "${envs_differ}" = 1 ] && echo true || echo false)" \
            "$(json_str "${u_fw_s}")" "$(json_str "${u_fw_t}")" "$(json_str "${fwd}")" "$(json_str "${in4}")" \
            "${vms:-0}" "${dirs:-0}" "$(json_str "${disk}")" \
            "$(json_str "${dockerv}")" "$(json_str "${katav}")" "$(json_str "${operator}")" "${rc}"
        return "${rc}"
    fi
    echo "styrman-ctl status  (host ${host}, $(date '+%F %H:%M'))"
    if [ "${installed}" != 1 ]; then echo "  nothing installed: no styrman units, no styrman-server container"; return "${rc}"; fi
    echo "  server     ${health:-absent}   ${server_img:-no styrman-server container} (${caddy_img:-no caddy})   ${url}"
    echo "  deployed   ${dver:-unknown}    ${ETC_DIR}/update/deployed-version${dsha:+, sha ${dsha}}${fver:+ ; FAILED-VERSION LATCHED: ${fver}}"
    if [ -n "${clone_sha}" ]; then
        echo "  updater    ${u_up_t} (timer), ${u_up_s} (service)   clone ${DEPLOY_DIR} at ${clone_sha}${clone_tag:+ (${clone_tag})}$([ "${envs_differ}" = 1 ] && echo '   WARNING: deploy/.env differs between the checkout and the clone')"
    else
        echo "  updater    ${u_up_t} (timer)   no clone at ${DEPLOY_DIR} — auto-update not set up"
    fi
    echo "  firewall   ${u_fw_s} (service), ${u_fw_t} (timer)   chains STYRMAN-FWD (${fwd} rules) STYRMAN-IN (${in4})"
    echo "  projects   ${vms:-0} running microVMs, ${dirs:-0} project dirs, ${STATE_DIR} ${disk}"
    echo "  host       Docker ${dockerv:-?}, Kata ${katav:-?} (mvm), operator ${operator:-?}"
    case "${rc}" in 1) echo "  verdict    DEGRADED";; 0) echo "  verdict    OK";; esac
    return "${rc}"
}

# ─── install ────────────────────────────────────────────────────────────────
# wait_healthy SECONDS: the compose healthcheck's verdict on styrman-server.
wait_healthy() {
    local n="$1" i st
    if [ "${DRY}" = 1 ]; then echo "+ wait up to ${n}s for styrman-server to report healthy"; return 0; fi
    for ((i = 0; i < n; i++)); do
        st="$(container_field styrman-server '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}')"
        [ "${st}" = healthy ] && return 0
        sleep 1
    done
    echo "styrman-server is not healthy after ${n}s — last log lines:" >&2
    docker logs --tail 30 styrman-server >&2 2>/dev/null || true
    return 1
}

# ask_env_key KEY DEFAULT: prompt (validating, re-asking while interactive)
# and write the key to the checkout's .env. Unattended: the default must
# validate or the run dies naming the key.
ask_env_key() {
    local key="$1" default="$2" secret="" v
    case " ${SECRET_KEYS} " in *" ${key} "*) secret=1 ;; esac
    while :; do
        ask v "${key}" "${default}" "${secret}"
        if validate "${key}" "${v}"; then break; fi
        [ "${YES}" = 1 ] && die "invalid value for ${key} (non-interactive)"
        has_tty || die "invalid value for ${key}"
        default="${v}"
    done
    env_set "${ENV_FILE}" "${key}" "${v}"
}

# resolve_version FLAG: --version wins, else the checkout's newest reachable
# release tag without its v; never a bare commit sha (ADR-053).
resolve_version() {
    local v="$1"
    if [ -z "${v}" ]; then
        v="$(git -C "${REPO}" describe --tags --abbrev=0 2>/dev/null || true)"
        v="${v#v}"
    fi
    [[ "${v}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "no release version: pass --version X.Y.Z (the checkout has no reachable vX.Y.Z tag; a commit sha is never a version, ADR-053)"
    printf '%s' "${v}"
}

# https_origin: this checkout's origin as an https URL (an ssh form is
# rewritten; the updater clones over https with a token).
https_origin() {
    local o
    o="$(git -C "${REPO}" remote get-url origin 2>/dev/null || true)"
    [ -n "${o}" ] || die "this checkout has no git remote 'origin' — the deploy clone needs one"
    o="$(printf '%s' "${o}" | sed -E 's#^git@([^:]+):#https://\1/#; s#^ssh://git@([^/]+)/#https://\1/#')"
    printf '%s' "${o}"
}

cmd_install() {
    local version="" env_file="" gh_token_file="" signers_file="" skip_au=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --user) OPERATOR="$2"; shift 2 ;;
            --version) version="$2"; shift 2 ;;
            --env-file) env_file="$2"; shift 2 ;;
            --gh-token-file) gh_token_file="$2"; shift 2 ;;
            --allowed-signers-file) signers_file="$2"; shift 2 ;;
            --skip-auto-update) skip_au=1; shift ;;
            *) die "install: unknown flag $1" ;;
        esac
    done
    need_root
    # Never from the updater's clone: an auto checkout there would stomp
    # the operator's work, and the clone is root's (host-setup.sh 8c).
    case "$(realpath -m -- "${REPO}")/" in "$(realpath -m -- "${DEPLOY_DIR}")/"*) die "refusing to install from ${REPO}: it is the auto-updater's clone (${DEPLOY_DIR}); run install from your own checkout" ;; esac
    [ -f /etc/debian_version ] || [ "${DRY}" = 1 ] || die "not a Debian host (R11: Debian 13)"
    [ -n "${OPERATOR}" ] || die "pass --user <operator account> (no SUDO_USER)"
    local t; for t in python3 curl git; do command -v "${t}" >/dev/null 2>&1 || die "${t} is required (apt-get install -y ${t})"; done
    [ -z "${env_file}" ] || [ -f "${env_file}" ] || die "--env-file ${env_file}: no such file"
    version="$(resolve_version "${version}")"

    log "install: host-setup.sh as root for operator ${OPERATOR}"
    run bash "${REPO}/deploy/host-setup.sh" --user "${OPERATOR}"

    log "install: deploy/.env — the must-fill keys"
    if [ ! -f "${ENV_FILE}" ]; then
        [ "${DRY}" = 1 ] || die "host-setup.sh did not scaffold ${ENV_FILE}"
        echo "+ (dry run) would prompt for: ${MUST_FILL} and write ${ENV_FILE}"
    else
        local key default
        for key in ${MUST_FILL}; do
            default="$(env_get "${ENV_FILE}" "${key}")"
            [ -z "${env_file}" ] || { local given; given="$(env_get "${env_file}" "${key}")"; [ -z "${given}" ] || default="${given}"; }
            ask_env_key "${key}" "${default}"
        done
    fi

    log "install: runtime image and stack at version ${version} (from this checkout — the documented first bring-up)"
    run docker build -t "styrman-runtime:${version}" --build-arg "STYRMAN_VERSION=${version}" "${REPO}/image"
    run env "STYRMAN_VERSION=${version}" docker compose -f "${REPO}/deploy/docker-compose.yml" --env-file "${ENV_FILE}" up -d --build
    wait_healthy 120 || die "the stack came up but styrman-server is not healthy; \`styrman-ctl status\` and \`docker logs styrman-server\`"
    local base hn; base="$(env_get "${ENV_FILE}" BASE_DOMAIN)"; hn="$(env_get "${ENV_FILE}" STYRMAN_HOSTNAME)"
    [ -z "${base}" ] || log "install: styrman is up at https://${hn:-styrman}.${base}"

    if [ "${skip_au}" = 1 ]; then
        log "install: auto-update skipped (--skip-auto-update); \`styrman-ctl update --setup\` sets it up later"
    elif [ "${YES}" = 1 ] && { [ -z "${gh_token_file}" ] || [ -z "${signers_file}" ]; }; then
        log "install: auto-update skipped — unattended and no --gh-token-file/--allowed-signers-file; \`styrman-ctl update --setup\` sets it up later"
    else
        local want=y
        [ "${YES}" = 1 ] || ask want "Set up auto-update now (the updater deploys signed release tags itself)? [y/N]" "n"
        case "${want}" in y|Y|yes) setup_auto_update "${gh_token_file}" "${signers_file}" ;; *) log "install: auto-update not set up; \`styrman-ctl update --setup\` does it later" ;; esac
    fi

    log "install: done. Log out and back in once so YOUR shell picks up the docker group (host-setup.sh added ${OPERATOR} to it; this run needed no group, it ran as root)."
}

# ─── update --setup: host-setup.sh 8c's prose as code ───────────────────────
# Every hand invocation of the updater names ALL of its inputs: the state dir
# (no default by design, ADR-052), the clone, and the token/signers files —
# the last two default to /etc/styrman inside the updater, which is only
# right when ETC_DIR is /etc/styrman (review finding, Phase 2).
UPDATER_ENV=("STYRMAN_UPDATE_STATE_DIR=${ETC_DIR}/update" "STYRMAN_DEPLOY_DIR=${DEPLOY_DIR}" "STYRMAN_GH_TOKEN_FILE=${ETC_DIR}/gh-token" "STYRMAN_ALLOWED_SIGNERS=${ETC_DIR}/allowed_signers")
is_signers_line() { [[ "$1" =~ ^[^[:space:]]+\ (ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com)\ [A-Za-z0-9+/=]+ ]]; }

# setup_auto_update [TOKEN_FILE] [SIGNERS_FILE]
setup_auto_update() {
    local token_file="${1:-}" signers_file="${2:-}" token="" signers="" origin tmpd
    [ -x "${BIN_DIR}/styrman-update" ] || [ "${DRY}" = 1 ] || die "${BIN_DIR}/styrman-update is not installed — run install first"
    if [ -n "${token_file}" ]; then
        [ -f "${token_file}" ] || die "--gh-token-file ${token_file}: no such file"
        token="$(tr -d '\n' < "${token_file}")"
    else
        ask token "GitHub fine-grained token for this repository (Contents: read-only; never echoed)" "" secret
    fi
    [ -n "${token}" ] || die "empty GitHub token"
    if [ -n "${signers_file}" ]; then
        [ -f "${signers_file}" ] || die "--allowed-signers-file ${signers_file}: no such file"
        signers="$(head -1 "${signers_file}")"
    else
        ask signers "allowed_signers line: <your-git-email> <key type> <public key> (from ~/.ssh/id_ed25519.pub)" ""
    fi
    is_signers_line "${signers}" || die "not an allowed_signers line: expected '<email> <ssh key type> <base64 key>'"
    origin="$(https_origin)"

    if [ "${DRY}" = 1 ]; then
        # The plan names the temp paths; nothing — secrets least of all —
        # touches the disk under --dry-run (review finding).
        tmpd="<tmpdir>"
    else
        tmpd="$(mktemp -d)"; chmod 700 "${tmpd}"
        trap 'rm -rf "${tmpd}"' EXIT
        # Secrets travel through root-only temp files, never argv or the plan.
        (umask 077; printf '%s' "${token}" > "${tmpd}/gh-token"; printf '%s\n' "${signers}" > "${tmpd}/allowed_signers")
        # One-shot askpass: git asks for a username, then a password; nothing
        # is stored in any git config (the updater has its own helper reading
        # the root-only token file, host-setup.sh 8c).
        # shellcheck disable=SC2016  # $1 belongs to the helper script being written
        printf '#!/usr/bin/env bash\ncase "$1" in *sername*) echo x-access-token ;; *) cat "%s" ;; esac\n' "${ETC_DIR}/gh-token" > "${tmpd}/askpass"
        chmod 700 "${tmpd}/askpass"
    fi

    log "auto-update: token → ${ETC_DIR}/gh-token (root, 600)"
    run install -d -m 700 -o root -g root "${ETC_DIR}"
    run install -m 600 -o root -g root "${tmpd}/gh-token" "${ETC_DIR}/gh-token"
    if [ -d "${DEPLOY_DIR}/.git" ]; then
        log "auto-update: clone exists at ${DEPLOY_DIR} — fetching tags"
        run env "GIT_ASKPASS=${tmpd}/askpass" GIT_TERMINAL_PROMPT=0 git -C "${DEPLOY_DIR}" fetch --tags
    else
        log "auto-update: cloning ${origin} → ${DEPLOY_DIR} (https, token via a one-shot askpass)"
        run env "GIT_ASKPASS=${tmpd}/askpass" GIT_TERMINAL_PROMPT=0 git clone "${origin}" "${DEPLOY_DIR}"
    fi
    run chown -R root:root "${DEPLOY_DIR}"
    if [ -f "${CLONE_ENV}" ] && [ -f "${ENV_FILE}" ] && ! cmp -s "${CLONE_ENV}" "${ENV_FILE}"; then
        local ow=n
        if [ "${YES}" = 1 ]; then ow=y; else ask ow "${CLONE_ENV} differs from ${ENV_FILE}; overwrite the clone's copy? [y/N]" "n"; fi
        case "${ow}" in y|Y|yes) run install -m 600 -o root -g root "${ENV_FILE}" "${CLONE_ENV}" ;; *) log "auto-update: keeping the clone's .env" ;; esac
    else
        if [ -f "${ENV_FILE}" ]; then
            run install -m 600 -o root -g root "${ENV_FILE}" "${CLONE_ENV}"
        elif [ "${DRY}" = 1 ]; then
            echo "+ (dry run) would copy ${ENV_FILE} → ${CLONE_ENV}"
        else
            die "no ${ENV_FILE} to copy into the clone — run install first"
        fi
    fi
    log "auto-update: allowed_signers → ${ETC_DIR}/allowed_signers (root, 644)"
    run install -m 644 -o root -g root "${tmpd}/allowed_signers" "${ETC_DIR}/allowed_signers"
    log "auto-update: dry check, then enable the timer and run the first tick"
    run env "${UPDATER_ENV[@]}" "${BIN_DIR}/styrman-update" --check
    run systemctl enable --now styrman-update.timer
    run systemctl start styrman-update.service
    [ "${DRY}" = 1 ] || { rm -rf "${tmpd}"; trap - EXIT; }
}

# ─── update: one auto-updater tick (or a forced redeploy of the current tag) ─
cmd_update() {
    local setup=0 redeploy=0 gh_token_file="" signers_file=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --setup) setup=1; shift ;;
            --redeploy) redeploy=1; shift ;;
            --gh-token-file) gh_token_file="$2"; shift 2 ;;
            --allowed-signers-file) signers_file="$2"; shift 2 ;;
            *) die "update: unknown flag $1" ;;
        esac
    done
    need_root
    if [ "${setup}" = 1 ]; then setup_auto_update "${gh_token_file}" "${signers_file}"; return; fi
    # The updater is THE update path (versioning.md): signature-verified,
    # from its own clone. The wrapper never runs compose against the clone
    # by hand — the break-glass command stays a documented command.
    [ "$(systemctl is-enabled styrman-update.timer 2>/dev/null || true)" = enabled ] || [ "${DRY}" = 1 ] \
        || die "auto-update is not set up on this host — run \`styrman-ctl update --setup\` first"
    if [ "${redeploy}" = 1 ]; then
        log "update: forced redeploy of the current tag (clears a latched failed-version)"
        run env "${UPDATER_ENV[@]}" "${BIN_DIR}/styrman-update" --force
    else
        log "update: running one updater tick now (deploys the newest signed release tag, if newer)"
        run systemctl start styrman-update.service
    fi
    run journalctl -u styrman-update.service -n 20 --no-pager
    cmd_status || true
}

# ─── edit: the .env editor that re-applies ─────────────────────────────────
# The keys `edit` understands, in .env.example order; everything else is
# "edit the file by hand". Computed keys are listed read-only.
EDIT_KEYS="BASE_DOMAIN GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET CLOUDFLARE_API_TOKEN ADMIN_EMAIL STYRMAN_ALLOWED_EMAILS SUPERADMINS STYRMAN_HOSTNAME STYRMAN_PUBLIC_DOMAIN STYRMAN_PRIVATE_DOMAIN STYRMAN_IMAGE STYRMAN_IDLE_TIMEOUT STYRMAN_TRANSCRIPT_TTL STYRMAN_BROKER_ADDR AUTH_DOMAIN SHELL_DOMAIN APPS_DOMAIN DEFAULT_RPS CADDY_ADMIN"
masked() { case " ${SECRET_KEYS} " in *" $1 "*) [ -n "$2" ] && echo "********" || echo "" ;; *) echo "$2" ;; esac; }

cmd_edit() {
    local apply=1 kv changes=() targets=() src
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-apply) apply=0; shift ;;
            *=*) changes+=("$1"); shift ;;
            *) die "edit: unknown argument $1 (KEY=VALUE, or --no-apply)" ;;
        esac
    done
    need_root
    # Both copies when both exist: the updater deploys with the clone's.
    [ -f "${ENV_FILE}" ] && targets+=("${ENV_FILE}")
    [ -f "${CLONE_ENV}" ] && targets+=("${CLONE_ENV}")
    [ "${#targets[@]}" -gt 0 ] || die "no deploy/.env in this checkout or the clone — run install first"
    src="${targets[0]}"
    if [ "${#changes[@]}" = 0 ]; then
        has_tty || die "edit: no terminal — pass KEY=VALUE arguments"
        local keys=() k i n choice v cur
        read -r -a keys <<< "${EDIT_KEYS} ${COMPUTED_KEYS}"
        while :; do
            local also=""; [ -z "${targets[1]:-}" ] || also=" and the clone copy"
            echo "deploy/.env (${src}${also}):"
            i=0
            for k in "${keys[@]}"; do
                i=$((i + 1)); cur="$(env_get "${src}" "${k}")"
                local note=""
                case " ${COMPUTED_KEYS} " in *" ${k} "*) note="  (computed by host-setup.sh)" ;; esac
                printf '  %2d. %-24s %s%s\n' "${i}" "${k}" "$(masked "${k}" "${cur}")" "${note}"
            done
            read -r -p "number to change, or done: " choice < /dev/tty
            case "${choice}" in done|"") break ;; esac
            if ! { [[ "${choice}" =~ ^[0-9]+$ ]] && [ "${choice}" -ge 1 ] && [ "${choice}" -le "${#keys[@]}" ]; }; then echo "no such number"; continue; fi
            k="${keys[$((choice - 1))]}"
            case " ${COMPUTED_KEYS} " in *" ${k} "*) echo "${k} is computed by host-setup.sh — re-run install"; continue ;; esac
            n=0
            while :; do
                ask v "${k}" "$(env_get "${src}" "${k}")" "$(case " ${SECRET_KEYS} " in *" ${k} "*) echo 1 ;; esac)"
                validate "${k}" "${v}" && break
                n=$((n + 1)); [ "${n}" -lt 3 ] || { echo "giving up on ${k}"; v=""; break; }
            done
            [ -z "${v}" ] || changes+=("${k}=${v}")
        done
    fi
    [ "${#changes[@]}" -gt 0 ] || { log "edit: nothing changed"; return 0; }
    # Validate everything before writing anything.
    local key value
    for kv in "${changes[@]}"; do
        key="${kv%%=*}"; value="${kv#*=}"
        validate "${key}" "${value}" || die "edit: ${key} refused"
    done
    local t
    for kv in "${changes[@]}"; do
        key="${kv%%=*}"; value="${kv#*=}"
        for t in "${targets[@]}"; do env_set "${t}" "${key}" "${value}"; done
        log "edit: ${key} set in ${#targets[@]} file(s)"
    done
    [ "${apply}" = 1 ] || { log "edit: written, not applied (--no-apply); apply with \`styrman-ctl edit\` later or restart the stack"; return 0; }
    # Re-apply: recreate the stack at the DEPLOYED version from the dir the
    # updater deploys from (the clone) or, without one, this checkout. No
    # --build: images are immutable per version; a changed env needs a
    # recreate only.
    local ver dir
    ver="$(deployed_version)"; ver="${ver#v}"
    [[ "${ver}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "edit: cannot tell the deployed version (no updater state, no running styrman-server) — start the stack first"
    if [ -f "${CLONE_ENV}" ]; then dir="${DEPLOY_DIR}"; else dir="${REPO}"; fi
    log "edit: re-applying — recreating the stack at ${ver} from ${dir}"
    run env "STYRMAN_VERSION=${ver}" docker compose -f "${dir}/deploy/docker-compose.yml" --env-file "${dir}/deploy/.env" up -d
    wait_healthy 120 || die "the stack was recreated but styrman-server is not healthy; \`styrman-ctl status\`"
    cmd_status || true
}

# ─── Internal test hooks (used by the Go test; not for operators) ───────────
# Gated: `__env-set` can rewrite any file as root, so the hooks exist only
# when the test harness says so (security review).
cmd_internal() {
    [ "${STYRMAN_CTL_TEST:-}" = 1 ] || die "internal test hooks are disabled (set STYRMAN_CTL_TEST=1 only under the Go test)"
    case "${1:-}" in
        __validate)  validate "$2" "$3" ;;
        __env-set)   env_set "$2" "$3" "$4" ;;
        __env-get)   env_get "$2" "$3" ;;
        __guard-path) guard_path "$2" ;;
        *) die "unknown internal verb ${1:-}" ;;
    esac
}

cmd_help() {
    cat <<H
styrman-ctl — install, update, edit, uninstall and inspect a styrman host

  sudo deploy/styrman-ctl                menu
  sudo deploy/styrman-ctl status [--json]
  sudo deploy/styrman-ctl install [--user U] [--version X.Y.Z] [--env-file F] [--gh-token-file F] [--allowed-signers-file F] [--skip-auto-update]
  sudo deploy/styrman-ctl update [--redeploy] | --setup [--gh-token-file F] [--allowed-signers-file F]
  sudo deploy/styrman-ctl edit [KEY=VALUE ...] [--no-apply]
  sudo deploy/styrman-ctl uninstall …    (not yet: plan phase 4)
  deploy/styrman-ctl help

Global flags: --dry-run (print every command, run nothing), --yes (take
defaults, skip non-destructive confirmations), --confirm WORD (satisfy a
destructive confirmation unattended).
Paths: STYRMAN_STATE_DIR, STYRMAN_DEPLOY_DIR, STYRMAN_ETC_DIR, STYRMAN_UNIT_DIR,
STYRMAN_BIN_DIR, STYRMAN_SBIN_DIR, STYRMAN_TMPFILES_DIR (defaults: the
production locations host-setup.sh and the units pin).
H
}

cmd_menu() {
    has_tty || { cmd_help; exit 2; }
    local choice
    echo "styrman-ctl"
    echo "  1) install    2) update    3) edit    4) uninstall    5) status    q) quit"
    read -r -p "> " choice < /dev/tty
    case "${choice}" in
        1) main install ;; 2) main update ;; 3) main edit ;; 4) main uninstall ;; 5) main status ;;
        q|Q|"") exit 0 ;; *) die "no such choice: ${choice}" ;;
    esac
}

main() {
    local verb="${1:-}"; [ $# -gt 0 ] && shift
    # Global flags may sit anywhere; verbs get the rest.
    local rest=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run) DRY=1; shift ;;
            --yes) YES=1; shift ;;
            --confirm) CONFIRM_GIVEN="$2"; shift 2 ;;
            *) rest+=("$1"); shift ;;
        esac
    done
    set -- "${rest[@]+"${rest[@]}"}"
    case "${verb}" in
        "") cmd_menu ;;
        status) cmd_status "$@" ;;
        help|-h|--help) cmd_help ;;
        install) cmd_install "$@" ;;
        update) cmd_update "$@" ;;
        edit) cmd_edit "$@" ;;
        uninstall) die "${verb}: not implemented yet (plan .agents/docs/plans/2026-09-11-installer-ctl.md)" ;;
        __*) cmd_internal "${verb}" "$@" ;;
        *) die "unknown verb ${verb} (try: help)" ;;
    esac
}
main "$@"
