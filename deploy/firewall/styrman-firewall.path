[Unit]
Description=Apply styrman per-project LAN policy on change
# Deliberately NO After=docker.service here: path units are Before=paths.target,
# basic.target is After=paths.target and docker.service is After=basic.target,
# so ordering this unit after docker closes a cycle systemd breaks by deleting
# a job — unpredictably. The triggered .service orders itself after docker.

[Path]
# A state condition, not an event: re-checked every time the service exits,
# so a trigger file created while a run was in progress is never lost.
DirectoryNotEmpty=/run/styrman-firewall/spool
Unit=styrman-firewall.service
# Brake on a runaway spool, matched to the service's own start limit; the
# script revives a failed unit at most once per ten minutes.
TriggerLimitIntervalSec=60s
TriggerLimitBurst=20

[Install]
WantedBy=paths.target
