# styrman server image (Phase 3): the single Go binary + embedded UI,
# containerized so the vendored Caddy ingress can discover it by labels.
# Runs as the operator's UID (compose: user + group_add docker) so files it
# creates in the per-project homes keep the right ownership.
# Pinned patch version (operator rule: no floating tags). Keep this at the
# NEWEST 1.25.x: govulncheck flags dozens of CALLED stdlib vulns across the
# 1.25 series (h2c, TLS post-handshake, net/textproto, crypto/x509 — fixes
# spread from 1.25.4 through 1.25.13), and this binary is internet-facing.
FROM golang:1.25.13-trixie@sha256:6be3daa12135c38c177e2fbbf38ef2ad000d09b34bfa9f73dd7ca785bff134a5 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG STYRMAN_VERSION=0.0.0
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-s -w -X github.com/kesokaj/styrman-crew/internal/httpapi.Version=${STYRMAN_VERSION}" \
    -o /out/styrman ./cmd/styrman/

FROM debian:trixie-slim@sha256:abc9cb88a5587630d7f915f47b23b0668fe250fbfc6457aa4d52b534c1bbf73f
RUN apt-get update && apt-get install --no-install-recommends -y ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/styrman /usr/local/bin/styrman
# State dir and docker.sock are bind-mounted at the SAME paths as the host so
# the bind sources the server passes to project containers stay valid.
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD curl -fsS http://localhost:8080/api/health || exit 1
ENTRYPOINT ["/usr/local/bin/styrman"]

# Version stamp, LAST so a version bump does not bust the layers above it.
# The auto-updater verifies a deploy by reading this label with `docker inspect`
# — no HTTP, no auth, no ingress token. Querying /api/version instead needed a
# fake identity that STYRMAN_AUTH=header rejects with 403, which made every
# healthy release look like a failure (review, 2026-09-01). Deleting this LABEL
# breaks the updater: it would roll back every release.
ARG STYRMAN_VERSION=0.0.0
LABEL styrman.version="${STYRMAN_VERSION}"
