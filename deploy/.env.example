# styrman deployment config — copy to deploy/.env and fill in.
# deploy/host-setup.sh generates the computed values (UID/GID/DOCKER_GID)
# automatically; you supply the secrets/domains in the must-fill section below.

# ── You must fill these in ─────────────────────────────
# Your domain; styrman appears at https://${STYRMAN_HOSTNAME}.${BASE_DOMAIN},
# the Google OAuth portal at https://auth.${BASE_DOMAIN}.
BASE_DOMAIN=
# Google OAuth 2.0 client (https://console.cloud.google.com/apis/credentials):
# type "Web application", authorized redirect URI:
#   https://auth.<BASE_DOMAIN>/oauth2/google/authorization-code-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ACME registration contact.
ADMIN_EMAIL=

# Who may log in (comma-separated Google accounts). Used by BOTH layers:
# the Caddy authorization policy and styrman's own userstore re-check.
STYRMAN_ALLOWED_EMAILS=
SUPERADMINS=${STYRMAN_ALLOWED_EMAILS}

# ── Computed by host-setup.sh (operator identity + docker group) ────────────
STYRMAN_UID=1000
STYRMAN_GID=1000
DOCKER_GID=999
STYRMAN_USER=changeme

# ── Optional tuning ─────────────────────────────────────────────────────────
STYRMAN_HOSTNAME=styrman
# Cloudflare API token with Zone:DNS:Edit on BASE_DOMAIN. When set, the
# ingress auto-manages DNS A records (auth + app + wildcards) and issues TLS
# certs via DNS-01 ACME challenges. When empty, Caddy uses HTTP-01 challenges
# (works for non-wildcard hostnames) and DNS records must be managed out of
# band (e.g. via gcloud dns or a console). Required for wildcard certs
# (preview/private domains).
# CLOUDFLARE_API_TOKEN=
# Public preview links (1.1). Set to enable: the ingress adds a public
# *.<value> wildcard (DNS + cert + route) → the server, and a "public link" is
# minted as https://<token>.<value>/ (no login, TTL-bounded). One var drives
# both the ingress (PREVIEW_DOMAIN) and the server (STYRMAN_PREVIEW_BASE).
# Leave empty to keep the feature off.
# STYRMAN_PUBLIC_DOMAIN=public.${STYRMAN_HOSTNAME}.${BASE_DOMAIN}
# Private share links (1.2). Set to enable: like the public wildcard but the
# ingress requires Google sign-in, and the server checks the visitor's email
# against the port's share list. Sharing a port mints a stable
# https://<token>.<value>/ URL shown in the share panel.
# STYRMAN_PRIVATE_DOMAIN=private.${STYRMAN_HOSTNAME}.${BASE_DOMAIN}
# Runtime image the server boots project VMs from. Leave UNSET in production:
# compose derives styrman-runtime:${STYRMAN_VERSION}, so projects always boot
# the release's own immutable tag. Never point this at a mutable tag
# (:dev/:latest) in a deploy — operator rule; a stale line here would also
# outrank the compose default and silently re-pin every project.
# STYRMAN_IMAGE=
STYRMAN_IDLE_TIMEOUT=8h
# Transcript retention: prune terminal transcripts older than this (0 = keep forever)
STYRMAN_TRANSCRIPT_TTL=720h
# Shared secret the Caddy ingress injects as X-Styrman-Ingress and the server
# requires in header-auth mode — blocks a project VM on the shared bridge from
# spoofing X-Caddy-Email directly against the server. host-setup.sh generates
# a real value; leave empty ONLY for a single-listener dev setup.
STYRMAN_INGRESS_TOKEN=
# Stable HMAC key for caddy-security JWTs — pins the signing key so browser
# sessions survive a Caddy restart/redeploy (without it, every redeploy logs
# everyone out). host-setup.sh generates a real value.
STYRMAN_JWT_KEY=
# Credential broker listener (ADR-030/032). Default :8091 if unset.
# STYRMAN_BROKER_ADDR=:8091   # container-only listener — never publish this to the host
# The host firewall (ADR-036/067) is installed once per host with
# `sudo bash deploy/firewall/install.sh`; nothing about it is configured here.
# ADR-067 deleted the root-mediated spool that ADR-065/066 had: a project's
# mode is now its Docker bridge interface name, chosen by the server, and the
# server never touches iptables. There is no STYRMAN_FIREWALL_DIR -- the
# variable named here until 2026-09-22 had been read by no code since ADR-067,
# and docker-compose.yml does not set it.
# STYRMAN_VERSION is NOT set here — it's passed on the compose command line
# instead (see the README quick start): `STYRMAN_VERSION=X.Y.Z docker compose
# ... up -d --build`. There is NO fallback: compose refuses to run without it
# (mutable tags are banned, so every image name needs the explicit version).

# ── Optional ingress knobs (read by the vendored Caddy ingress; defaults fine) ──
# AUTH_DOMAIN=auth          # subdomain label for the OAuth portal
# SHELL_DOMAIN=             # extra shell hostname (unused by default)
# APPS_DOMAIN=              # extra apps wildcard (unused by default)
# DEFAULT_RPS=              # per-client rate limit override
# CADDY_ADMIN=              # caddy admin bind, MUST be a loopback IP LITERAL with
                            # a port (default 127.0.0.1:2019). A NAME — including
                            # "localhost" — is refused: what a name binds is decided
                            # by /etc/hosts and NSS at bind time, so the guard cannot
                            # verify it. The admin API can replace the whole
                            # ingress config; a non-loopback value makes the caddy
                            # container REFUSE TO START — under restart:unless-stopped
                            # that is a whole-site-down crash loop, so leave unset
                            # unless you know why you are changing it.
