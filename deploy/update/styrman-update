#!/usr/bin/env bash
# styrman-update — pull and deploy the newest STABLE version tag.
#
# Ported from argolis-devbox's `devbox update` (operator request 2026-09-01),
# with the one change the operator asked for: it acts on VERSION TAGS ONLY,
# never on "whatever landed on the branch". Push a `vX.Y.Z` tag and the host
# picks it up on the next timer tick; push commits and nothing happens.
#
# Two deliberate departures from the argolis original:
#
#   1. It operates on a DEDICATED deploy clone (default /opt/styrman), never
#      on the operator's working tree. argolis deployed from /opt/devbox, but
#      styrman's compose builds from the repo root, and on this host that has
#      been the operator's own checkout — `git checkout <tag>` there would
#      stomp in-progress work.
#   2. It rolls back. If the new version fails to report itself healthy, the
#      previous tag is rebuilt and redeployed rather than leaving the box on a
#      broken version.
#
# Both images are rebuilt on every tag (operator's choice): the server, and
# the runtime image — the latter re-seeds every project's agent harness on its
# next boot, which is the ADR-046 delivery path.
#
# Usage: styrman-update [--check] [--force]
#   --check   report what would happen, change nothing
#   --force   rebuild + redeploy at the CURRENT tag even if nothing is new
set -euo pipefail

DEPLOY_DIR="${STYRMAN_DEPLOY_DIR:-/opt/styrman}"
LOCK="/run/styrman-update.lock"
# State lives OUTSIDE the clone. It used to sit at the clone root, where the
# `git clean -d` in deploy() deleted it — wiping the failed-tag latch and
# reinstating the very retry storm the latch exists to prevent (review finding;
# reproduced: both dotfiles gone after one clean).
# There is NO in-script default (ADR-052): during the 2026-09-01 state-loss
# incident, privileged test runs against a production-aliasing default state
# path preceded the wipe of /var/lib/styrman and the rm -rf of /etc/styrman.
# The production path (/etc/styrman/update — root-owned 0700, NOT the
# operator-chowned /var/lib/styrman, security review) is pinned in
# styrman-update.service; anything invoking this script outside that unit must
# choose a state dir on purpose — tests pass a scratch prefix.
STATE_DIR="${STYRMAN_UPDATE_STATE_DIR:-}"
# The three files in it (paths derived AFTER the guard below canonicalizes
# STATE_DIR): deployed-version — the tag last successfully deployed;
# deployed-sha — the exact commit it was built from (rolling back to a SHA is
# immune to a re-pointed tag AND needs no re-verification: that tree was
# already verified when it was deployed; re-verifying the old TAG would fail
# for any release made before signing was adopted — review finding);
# failed-version — a tag that failed and was rolled back, so the timer stops
# retrying the same broken release every tick.
# NOTE: the runtime image tag is derived per-deploy from the release version
# (styrman-runtime:X.Y.Z) inside deploy() — never a mutable tag (operator
# rule): a :dev/:latest tag made "what do projects boot" depend on whoever
# last ran a build, and made rollback unable to restore the exact old image.
# How long to wait for the new server to report its version before rolling back.
HEALTH_TIMEOUT="${STYRMAN_UPDATE_HEALTH_TIMEOUT:-120}"

CHECK_ONLY=false
FORCE=false
for arg in "$@"; do
    case "${arg}" in
        --check) CHECK_ONLY=true ;;
        --force) FORCE=true ;;
        *) echo "unknown flag: ${arg}" >&2; exit 2 ;;
    esac
done

log()  { echo "[styrman-update] $*"; }
fail() { echo "[styrman-update] FATAL: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || fail "must run as root"
# ADR-052: no production-path default outside the systemd unit. Production runs
# go through `systemctl start styrman-update.service` (the unit pins
# /etc/styrman/update); a hand-run must pick its state dir explicitly, and a
# TEST run must pass a scratch prefix that cannot alias production state.
[ -n "${STATE_DIR}" ] || fail "STYRMAN_UPDATE_STATE_DIR is not set — production: systemctl start styrman-update.service (or pass /etc/styrman/update explicitly); tests: pass a NESTED scratch path, e.g. \$(mktemp -d)/state (ADR-052)"
# Canonicalize before the refusal check: //var/lib/styrman, relative paths and
# symlinked aliases must not slip past a literal prefix match (security review).
STATE_DIR="$(realpath -m -- "${STATE_DIR}")" || fail "cannot canonicalize STYRMAN_UPDATE_STATE_DIR"
case "${STATE_DIR}" in
    /var/lib/styrman|/var/lib/styrman/*)
        # Operator-owned production data — both the ADR-052 incident path and
        # the deployed-sha trust hole the security review closed.
        fail "STYRMAN_UPDATE_STATE_DIR=${STATE_DIR} is inside /var/lib/styrman — refusing (ADR-052)" ;;
esac
STATE="${STATE_DIR}/deployed-version"
STATE_SHA="${STATE_DIR}/deployed-sha"
FAILED="${STATE_DIR}/failed-version"
[ -d "${DEPLOY_DIR}/.git" ] || fail "no deploy clone at ${DEPLOY_DIR} (see host-setup.sh step 8c)"
# compose reads this for the ingress token, uid/gid, &c. The updater no longer
# reads it itself (the version check uses a container label), but a build
# without it produces a broken stack.
[ -f "${DEPLOY_DIR}/deploy/.env" ] || fail "${DEPLOY_DIR}/deploy/.env missing — the deploy clone needs its own secrets file"

# Serialize: a build can outlast the timer interval, and two concurrent
# checkouts of the same tree would corrupt each other. (The argolis original
# had no lock and its 5-minute timer could stack.)
# -m with -p only applies to the deepest dir (SC2174), so create the parent
# explicitly: a fresh /etc/styrman must be 0700 too, not just the leaf. Create
# ONLY what is missing — `install -d` re-modes an EXISTING dir, and with the
# state dir now caller-chosen (ADR-052) that turned a root `--check` against
# $(mktemp -d) into chmod 0700 root:root of /tmp itself (review+security
# finding, measured). An existing dir's ownership/mode is asserted below, not
# forced here.
STATE_PARENT="$(dirname "${STATE_DIR}")"
[ -d "${STATE_PARENT}" ] || install -d -m 700 -o root -g root "${STATE_PARENT}" || fail "cannot create ${STATE_PARENT}"
[ -d "${STATE_DIR}" ] || install -d -m 700 -o root -g root "${STATE_DIR}" || fail "cannot create ${STATE_DIR}"
# The rollback trusts deployed-sha enough to skip verification, so the dir it
# lives in gets the same ownership+mode guarantee as every other trust input.
[ "$(stat -c %u "${STATE_DIR}")" = "0" ] \
    || fail "${STATE_DIR} is not root-owned — refusing to trust the recorded deploy state"
[ -z "$(find "${STATE_DIR}" -maxdepth 0 -perm /022 2>/dev/null)" ] \
    || fail "${STATE_DIR} is group/world-writable — refusing to trust the recorded deploy state"
exec 9>"${LOCK}"
flock -n 9 || { log "another run is in progress — skipping this tick"; exit 0; }

cd "${DEPLOY_DIR}"
# git refuses to operate on a tree owned by another user. Pass it per-command
# with `git -c` instead of `git config --global --add`, which never
# de-duplicates and grew /root/.gitconfig by one line every tick — ~105k lines
# a year at this cadence (review finding).
# Assert the clone is root-owned BEFORE disabling git's ownership guard for it:
# `-c safe.directory` on a tree someone else can write would let them choose the
# code this script builds as root (security review).
[ "$(stat -c %u "${DEPLOY_DIR}/.git" 2>/dev/null)" = "0" ] \
    || fail "${DEPLOY_DIR}/.git is not root-owned — refusing to build from a tree another user can write"
# deploy/.env survives both `checkout --force` and `git clean -d` (it is
# gitignored) and supplies STYRMAN_ALLOWED_EMAILS to the stack, so it needs the
# same ownership guarantee as the tree itself (security review).
[ "$(stat -c %u "${DEPLOY_DIR}/deploy/.env" 2>/dev/null)" = "0" ] \
    || fail "${DEPLOY_DIR}/deploy/.env is not root-owned — refusing to deploy with credentials another user can write"
# Mode, not just owner: a root-owned 0666 passed an ownership-only check, and a
# root-owned 0644 leaks STYRMAN_INGRESS_TOKEN / STYRMAN_ALLOWED_EMAILS.
[ -z "$(find "${DEPLOY_DIR}/deploy/.env" -perm /077 2>/dev/null)" ] \
    || fail "${DEPLOY_DIR}/deploy/.env is readable or writable beyond root (chmod 600 it) — it holds the ingress token"
# The repo is PRIVATE and this runs as root. Auth is a FINE-GRAINED GitHub
# token (operator decision 2026-09-01: the host holds NO SSH key) — scoped to
# this ONE repository with Contents: Read-only, stored root-only at
# /etc/styrman/gh-token, fed to git over HTTPS via an inline credential
# helper. Never in the remote URL: a URL-embedded token lands in .git/config
# and every process listing. TLS to github.com replaces the SSH known_hosts
# trust anchor the old deploy-key path needed. GIT_TERMINAL_PROMPT=0 makes a
# missing/expired token FAIL FAST instead of hanging on a credential prompt —
# fine-grained tokens expire, and "cannot see new versions" must be loud
# (review finding: a fetch failure was once a single WARN in a long log).
export GIT_TERMINAL_PROMPT=0
GH_TOKEN_FILE="${STYRMAN_GH_TOKEN_FILE:-/etc/styrman/gh-token}"
# Exported so the helper below reads it from its OWN environment — the path is
# never interpolated into the git-evaluated shell string (security review: an
# unquoted interpolation made a path with spaces yield an empty password, and
# operator-env paths are a root shell-injection surface).
export GH_TOKEN_FILE
# ALWAYS clear inherited credential helpers — with or without a token file —
# so an ambient root credential store can never silently answer for a fetch
# whose output is built and run as root (security review).
GIT_CRED_ARGS=(-c credential.helper=)
if [ -f "${GH_TOKEN_FILE}" ]; then
    # Same trust bar as every other root input this script reads.
    [ "$(stat -c %u "${GH_TOKEN_FILE}")" = "0" ] \
        || fail "${GH_TOKEN_FILE} is not root-owned — refusing to authenticate with a token another user controls"
    [ -z "$(find "${GH_TOKEN_FILE}" -perm /077 2>/dev/null)" ] \
        || fail "${GH_TOKEN_FILE} is readable or writable beyond root (chmod 600 it)"
    # URL-SCOPED to https://github.com (security review, verified: an
    # unscoped helper hands the token to a probe for ANY host; the scoped
    # form fails closed elsewhere). Single-quoted: nothing expands here —
    # the helper resolves "$GH_TOKEN_FILE" from the exported env at run time.
    # shellcheck disable=SC2016
    GIT_CRED_ARGS+=(-c 'credential.https://github.com.helper=!f() { echo username=x-access-token; printf "password=%s\n" "$(cat "${GH_TOKEN_FILE}")"; }; f')
fi
git() { command git -c safe.directory="${DEPLOY_DIR}" "${GIT_CRED_ARGS[@]}" "$@"; }

# ─── Find the newest STABLE tag ─────────────────────────────────────────────
# --force so a re-tagged release is picked up; --prune-tags so a DELETED tag
# stops being a candidate (without it a withdrawn release would live forever
# in the local clone and keep reinstalling itself).
# Fail LOUDLY on a fetch error rather than silently deploying from stale local
# tags: "no new version" and "cannot see new versions" must not look identical.
if ! git fetch --tags --force --prune --prune-tags origin 2>&1; then
    fail "git fetch failed — root cannot reach ${DEPLOY_DIR}'s origin. For a private repo: mint a FINE-GRAINED GitHub token (this repo only, Contents: Read-only) and install it at ${GH_TOKEN_FILE} (root:root, chmod 600); the origin must be an https:// URL. Expired token? Fine-grained tokens have an expiry — mint a fresh one."
fi

# STRICTLY vX.Y.Z. Pre-releases (v1.16.0-rc1, -beta) are excluded by the
# anchored regex, so release candidates can be pushed without deploying them.
# sort -V picks the highest VERSION, not the most recently created tag.
LATEST="$(git tag -l 'v*' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1 || true)"
[ -n "${LATEST}" ] || fail "no stable vX.Y.Z tags found"

# ─── Tag integrity ──────────────────────────────────────────────────────────
# What this script does with a tag is check it out and BUILD IT AS ROOT, and
# docker-compose.yml lives inside that checkout — so a hostile revision only
# has to add a bind mount to own the host. Without a signature the trust set is
# "anyone who can push a tag" (account takeover, a future collaborator, a
# write-capable CI token), not "the operator" (security review, 2026-09-01).
#
# Fails CLOSED. Set STYRMAN_UPDATE_REQUIRE_SIGNED=0 in /etc/styrman/update.env
# to accept unsigned tags — a deliberate, root-only, logged choice.
#
# The opt-out is READ, not sourced. `. /etc/styrman/update.env` as root would
# execute whatever is in that file — and redefining log(){ :; } there would
# silence the "signature checking DISABLED" warning below, giving a silent
# skip path (security review). Ownership and mode are asserted first.
REQUIRE_SIGNED=1
if [ -f /etc/styrman/update.env ]; then
    if [ "$(stat -c '%u' /etc/styrman/update.env)" != "0" ]; then
        fail "/etc/styrman/update.env is not root-owned — refusing to read update policy from it"
    fi
    if [ -n "$(find /etc/styrman/update.env -perm /022 2>/dev/null)" ]; then
        fail "/etc/styrman/update.env is group/world-writable — refusing to read update policy from it"
    fi
    # Anchored: `...=0anything` must not disable it, and `export ...=0` must.
    if grep -qE '^[[:space:]]*(export[[:space:]]+)?STYRMAN_UPDATE_REQUIRE_SIGNED[[:space:]]*=[[:space:]]*"?0"?[[:space:]]*$' /etc/styrman/update.env; then
        REQUIRE_SIGNED=0
    fi
fi

# verify_tag <tag> — refuse anything we cannot attribute to an ALLOWED signer.
#
# `git verify-tag` alone is NOT sufficient: with GPG it exits 0 for a
# good-but-untrusted signature, so any key ever imported into root's keyring
# passes, and git never compares signer to tagger (verified empirically —
# security review). The SSH path DOES enforce an allowlist and fails closed
# when unconfigured, so that is the supported path and we ASSERT it is
# configured rather than relying on root's ambient gitconfig.
# ALLOWED_SIGNERS is a PINNED path, deliberately not read from root's gitconfig:
# the systemd unit sets ProtectHome=yes, so /root/.gitconfig is unreadable under
# the timer and `git config --global --get` returns empty there. That failed
# closed on every tick while a hand-run `sudo styrman-update` passed — the worst
# shape of bug, since it only appears after the operator enables the timer
# (review finding).
ALLOWED_SIGNERS="${STYRMAN_ALLOWED_SIGNERS:-/etc/styrman/allowed_signers}"

# verify_tag <tag> — returns non-zero rather than exiting, so callers inside an
# `if` condition (deploy) can take their own failure path.
verify_tag() {
    local tag="$1"
    [ "${REQUIRE_SIGNED}" = "1" ] || return 0
    # A lightweight tag is just a ref — it cannot carry a signature at all.
    if [ "$(git cat-file -t "${tag}" 2>/dev/null)" != "tag" ]; then
        log "REFUSED: ${tag} is a lightweight tag and cannot be verified. Re-tag with \`git tag -s ${tag}\` (signed, annotated), or opt out in /etc/styrman/update.env."
        return 1
    fi
    # REQUIRE an SSH signature. `-c gpg.format=ssh` does NOT force the SSH
    # verifier: git picks it from the signature's own armor header, so a
    # PGP-signed tag ignores the allowlist entirely and verifies against
    # whatever is in root's keyring — good-but-untrusted included (measured).
    # Only the SSH path consults gpg.ssh.allowedSignersFile, so anything else
    # is refused rather than silently unpinned.
    # Take the LAST armor header, matching git's own parse_signature: the tag
    # MESSAGE is author-controlled and `git cat-file tag` prints it, so a decoy
    # "-----BEGIN SSH SIGNATURE-----" line in the message passed a plain grep
    # while the real PGP block appended at the end still won — verify-tag then
    # exited 0 with the allowlist never consulted (security review reproduced
    # it). Comparing the last header closes that.
    if [ "$(git cat-file tag "${tag}" 2>/dev/null |
            grep -E '^-----BEGIN (SSH|PGP) SIGNATURE-----' | tail -1)" \
         != '-----BEGIN SSH SIGNATURE-----' ]; then
        log "REFUSED: ${tag} is not SSH-signed. Only SSH signatures are checked against the"
        log "  signer allowlist (${ALLOWED_SIGNERS}); a PGP signature would verify against any"
        log "  key in root's keyring and pin nothing. Re-tag with SSH signing:"
        log "    git config gpg.format ssh && git config user.signingkey ~/.ssh/id_ed25519.pub"
        return 1
    fi
    if [ -r "${ALLOWED_SIGNERS}" ] && { [ "$(stat -c %u "${ALLOWED_SIGNERS}")" != "0" ] ||
         [ -n "$(find "${ALLOWED_SIGNERS}" -perm /022 2>/dev/null)" ]; }; then
        log "REFUSED: ${ALLOWED_SIGNERS} must be root-owned and not group/world-writable —"
        log "  it decides whose tags this host will build and run as root."
        return 1
    fi
    if [ ! -r "${ALLOWED_SIGNERS}" ]; then
        log "REFUSED: ${ALLOWED_SIGNERS} is missing or unreadable, so no signer allowlist exists."
        log "  A bare \`git verify-tag\` accepts ANY key in root's keyring, so this is fatal by design."
        log "  Create it:  printf '%s %s\\n' <your-git-email> \"\$(cat ~/.ssh/id_ed25519.pub)\" | sudo tee ${ALLOWED_SIGNERS}"
        return 1
    fi
    if ! git -c gpg.ssh.allowedSignersFile="${ALLOWED_SIGNERS}" verify-tag "${tag}" 2>&1; then
        log "REFUSED: ${tag} is not signed by an allowed signer — will not build and run it as root."
        return 1
    fi
    log "${tag} signature OK (allowed signer)"
}

if [ "${REQUIRE_SIGNED}" != "1" ]; then
    log "WARNING: signature checking DISABLED — any pushed tag will be built and run as root"
fi
verify_tag "${LATEST}" || fail "refusing to deploy ${LATEST} (see above)"

CURRENT="$(cat "${STATE}" 2>/dev/null || true)"
# The state file is root-owned, but a malformed value (notably a leading "-")
# would be read by git as an OPTION. Accept only the tag shape we write.
if [ -n "${CURRENT}" ] && ! printf '%s' "${CURRENT}" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
    log "WARN: ignoring malformed ${STATE} contents"
    CURRENT=""
fi
if [ -z "${CURRENT}" ]; then
    # First run: fall back to whatever the clone is checked out at.
    CURRENT="$(git describe --tags --exact-match 2>/dev/null || echo none)"
fi

log "deployed=${CURRENT} latest-stable=${LATEST}"

# A previously failed tag is not retried automatically — only --force (or a
# newer tag) gets past this. Retrying a known-broken release on every tick
# would rebuild both images every few minutes and churn the live server.
if [ "$(cat "${FAILED}" 2>/dev/null || true)" = "${LATEST}" ] && [ "${FORCE}" = false ]; then
    log "${LATEST} previously FAILED to deploy and was rolled back — skipping."
    log "  investigate, then re-run with --force (or push a newer tag)."
    exit 0
fi
if [ "${FORCE}" = true ]; then
    rm -f "${FAILED}"
fi

if [ "${CURRENT}" = "${LATEST}" ] && [ "${FORCE}" = false ]; then
    log "already up to date"
    exit 0
fi
if [ "${CHECK_ONLY}" = true ]; then
    log "update AVAILABLE: ${CURRENT} → ${LATEST}"
    git --no-pager log --oneline "${CURRENT}..${LATEST}" 2>/dev/null | head -20 || true
    exit 0
fi

# ─── Deploy ─────────────────────────────────────────────────────────────────
# deploy <tag> — checkout, rebuild both images, bring the stack up.
# deploy <ref> <version> [trusted]
#   ref      what to check out — a tag, or a commit SHA on the rollback path
#   version  the version string to stamp (a SHA carries none of its own)
#   trusted  "trusted" skips verification. Used ONLY for a rollback to the
#            recorded SHA of a deploy this host already verified and ran; every
#            other path verifies. Rolling back by SHA is what makes the rollback
#            work at all: re-verifying the old TAG fails for every release made
#            before signing was adopted (v1.14.0-v1.15.0 here), and `git fetch
#            --tags --force` would accept a re-pointed tag anyway.
deploy() {
    local ref="$1" ver="$2" trusted="${3:-}"
    if [ "${trusted}" != "trusted" ]; then
        verify_tag "${ref}" || return 1
    else
        log "rolling back to a previously verified tree (${ref})"
    fi
    log "deploying ${ref} as ${ver}"
    git checkout --detach --force "${ref}" 2>/dev/null || { log "checkout ${ref} failed"; return 1; }
    # --force replaces TRACKED files but leaves untracked ones, and the server
    # image builds with `context: ..` — so a planted file would survive every
    # checkout into every image. `-d` without `-x` deliberately keeps ignored
    # files: deploy/.env is gitignored and must NOT be deleted.
    git clean -d --force --quiet || log "WARN: git clean failed"

    local runtime_image="styrman-runtime:${ver}"
    log "building runtime image (${runtime_image})"
    docker build -t "${runtime_image}" --build-arg "STYRMAN_VERSION=${ver}" "${DEPLOY_DIR}/image" \
        || return 1

    # Build EVERY compose service, not just styrman: the vendored Caddy ingress
    # is also built from this checkout, and `up -d` alone would leave a tag that
    # changes deploy/caddy/** shipping everything except the ingress — while
    # still reporting VERIFIED (review finding).
    # STYRMAN_IMAGE is passed explicitly: shell env outranks the clone's
    # deploy/.env in compose precedence, so a stale STYRMAN_IMAGE line left in
    # that file can never re-point projects at a mutable tag.
    log "building + starting the stack (server + ingress) at ${ver}"
    ( cd "${DEPLOY_DIR}/deploy" \
      && STYRMAN_VERSION="${ver}" STYRMAN_IMAGE="${runtime_image}" docker compose -f docker-compose.yml build \
      && STYRMAN_VERSION="${ver}" STYRMAN_IMAGE="${runtime_image}" docker compose -f docker-compose.yml up -d ) || return 1
}

# reports_version <x.y.z> — wait until the RUNNING server container is healthy
# and carries this version.
#
# Read from the container, not the HTTP API. The obvious implementation —
# polling /api/version — needed an identity header, and production runs
# STYRMAN_AUTH=header where authGuard exempts only /api/health, so a synthetic
# "updater@localhost" got 403 forever: every HEALTHY release would have timed
# out, rolled back, and latched its tag as failed (review finding). The label
# is stamped at build time (deploy/Dockerfile.server) and needs no auth, no
# ingress token, and no network.
#
# Fails CLOSED: any inability to confirm the version is a failure, because the
# caller uses this to decide whether to keep the release or roll it back.
reports_version() {
    local want="$1" deadline got health running
    got=""; health=""; running=""   # set -u: the loop may never execute
    deadline=$(( $(date +%s) + HEALTH_TIMEOUT ))
    while [ "$(date +%s)" -lt "${deadline}" ]; do
        got="$(docker inspect styrman-server \
              --format '{{index .Config.Labels "styrman.version"}}' 2>/dev/null || true)"
        # No healthcheck defined = "<no value>"; treat only an explicit
        # "unhealthy"/"starting" as not-ready.
        health="$(docker inspect styrman-server \
                 --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' 2>/dev/null || true)"
        running="$(docker inspect styrman-server --format '{{.State.Running}}' 2>/dev/null || true)"
        # An EMPTY label is never a match: an image built before version
        # labelling existed would otherwise compare equal to an empty want and
        # verify anything. (My own first test of this function passed for
        # exactly that reason.)
        # Must be RUNNING. "none" (no healthcheck defined) is accepted only
        # because a tag could legitimately drop the HEALTHCHECK line — but a
        # dead container must never verify, which "none" alone allowed.
        if [ -n "${got}" ] && [ "${got}" = "${want}" ] && [ "${running}" = "true" ] &&
           { [ "${health}" = "healthy" ] || [ "${health}" = "none" ]; }; then
            return 0
        fi
        sleep 5
    done
    if [ -z "${got}" ]; then
        log "version check failed: styrman-server carries NO styrman.version label."
        log "  An image built before labelling cannot be verified. Confirm by hand"
        log "  and re-run with --force once the running version is known-good."
    else
        log "version check failed: label=${got} want=${want} running=${running:-?} health=${health:-<none>}"
    fi
    return 1
}

PREVIOUS="${CURRENT}"
PREVIOUS_SHA="$(cat "${STATE_SHA}" 2>/dev/null || true)"
# Only a full 40-hex object name is usable as a rollback ref.
printf '%s' "${PREVIOUS_SHA}" | grep -qE '^[0-9a-f]{40}$' || PREVIOUS_SHA=""

if deploy "${LATEST}" "${LATEST#v}" && reports_version "${LATEST#v}"; then
    printf '%s' "${LATEST}" > "${STATE}"
    # Only record a trusted SHA when it was actually verified — otherwise a SHA
    # captured during an opt-out window would keep skipping verification after
    # signing is re-enabled (security review).
    if [ "${REQUIRE_SIGNED}" = "1" ]; then
        git rev-parse "${LATEST}^{commit}" > "${STATE_SHA}" 2>/dev/null || true
    else
        rm -f "${STATE_SHA}"
    fi
    rm -f "${FAILED}"
    log "OK — ${LATEST} is live"
    exit 0
fi

# ─── Rollback ───────────────────────────────────────────────────────────────
log "ERROR: ${LATEST} did not come up healthy within ${HEALTH_TIMEOUT}s"
# Latch BEFORE deciding what to do about it: on a first run there is no
# previous version to roll back to, and without the latch the timer would
# rebuild this same broken tag every 5 minutes forever (review finding).
printf '%s' "${LATEST}" > "${FAILED}"
if [ "${PREVIOUS}" = "none" ] || [ -z "${PREVIOUS}" ]; then
    fail "no previous version recorded — leaving the box as-is for manual repair. ${LATEST} is latched as failed; re-run with --force after fixing."
fi
log "rolling back to ${PREVIOUS}"
# Prefer the recorded SHA (already verified when it was deployed); fall back to
# the tag only when no SHA was recorded — e.g. the first run after adopting it.
if [ -n "${PREVIOUS_SHA}" ]; then
    rollback_ref="${PREVIOUS_SHA}"; rollback_trust="trusted"
else
    log "no recorded commit for ${PREVIOUS} — falling back to the tag, which must verify"
    rollback_ref="${PREVIOUS}"; rollback_trust=""
fi
if deploy "${rollback_ref}" "${PREVIOUS#v}" "${rollback_trust}" && reports_version "${PREVIOUS#v}"; then
    printf '%s' "${PREVIOUS}" > "${STATE}"
    fail "rolled back to ${PREVIOUS}. ${LATEST} is marked FAILED and will not be retried automatically — fix it and re-run with --force, or push a newer tag."
fi
fail "rollback to ${PREVIOUS} ALSO failed — manual intervention required"
