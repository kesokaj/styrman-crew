#!/usr/bin/env bash
# styrman-update — pull and deploy the newest STABLE version tag.
#
# Ported from argolis-devbox's `devbox update` (operator request 2026-09-01),
# with the one change the operator asked for: it acts on VERSION TAGS ONLY,
# never on "whatever landed on the branch". Push a `vX.Y.Z` tag and the host
# picks it up on the next timer tick; push commits and nothing happens.
#
# Two deliberate departures from the argolis original:
#
#   1. It operates on a DEDICATED deploy clone (default /opt/styrman), never
#      on the operator's working tree. argolis deployed from /opt/devbox, but
#      styrman's compose builds from the repo root, and on this host that has
#      been the operator's own checkout — `git checkout <tag>` there would
#      stomp in-progress work.
#   2. It rolls back. If the new version fails to report itself healthy, the
#      previous tag is rebuilt and redeployed rather than leaving the box on a
#      broken version.
#
# Both images are rebuilt on every tag (operator's choice): the server, and
# the runtime image — the latter re-seeds every project's agent harness on its
# next boot, which is the ADR-046 delivery path.
#
# Usage: styrman-update [--check] [--force]
#   --check   report what would happen, change nothing
#   --force   rebuild + redeploy at the CURRENT tag even if nothing is new
set -euo pipefail

DEPLOY_DIR="${STYRMAN_DEPLOY_DIR:-/opt/styrman}"
LOCK="/run/styrman-update.lock"
# State lives OUTSIDE the clone. It used to sit at the clone root, where the
# `git clean -d` in deploy() deleted it — wiping the failed-tag latch and
# reinstating the very retry storm the latch exists to prevent (review finding;
# reproduced: both dotfiles gone after one clean).
# There is NO in-script default (ADR-052): during the 2026-09-01 state-loss
# incident, privileged test runs against a production-aliasing default state
# path preceded the wipe of /var/lib/styrman and the rm -rf of /etc/styrman.
# The production path (/etc/styrman/update — root-owned 0700, NOT the
# operator-chowned /var/lib/styrman, security review) is pinned in
# styrman-update.service; anything invoking this script outside that unit must
# choose a state dir on purpose — tests pass a scratch prefix.
STATE_DIR="${STYRMAN_UPDATE_STATE_DIR:-}"
# The three files in it (paths derived AFTER the guard below canonicalizes
# STATE_DIR): deployed-version — the tag last successfully deployed;
# deployed-sha — the exact commit it was built from (rolling back to a SHA is
# immune to a re-pointed tag AND needs no re-verification: that tree was
# already verified when it was deployed; re-verifying the old TAG would fail
# for any release made before signing was adopted — review finding);
# failed-version — a tag that failed and was rolled back, so the timer stops
# retrying the same broken release every tick.
# NOTE: the runtime image tag is derived per-deploy from the release version
# (styrman-runtime:X.Y.Z) inside deploy() — never a mutable tag (operator
# rule): a :dev/:latest tag made "what do projects boot" depend on whoever
# last ran a build, and made rollback unable to restore the exact old image.
# How long to wait for the new server to report its version before rolling back.
HEALTH_TIMEOUT="${STYRMAN_UPDATE_HEALTH_TIMEOUT:-120}"

# ─── Functions (defined before any top-level action so the test verb below
# can reach verify_tag without the fetch/deploy flow) ────────────────────────
log()  { echo "[styrman-update] $*"; }
fail() { echo "[styrman-update] FATAL: $*" >&2; exit 1; }

# trusted_dir <dir> — the same bar every other root-written path in this
# script meets: exists, root-owned, not group/world-writable.
trusted_dir() {
    [ -d "$1" ] && [ "$(stat -c %u "$1")" = "0" ] && [ -z "$(find "$1" -maxdepth 0 -perm /022 2>/dev/null)" ]
}


# ALWAYS clear inherited credential helpers — with or without a token file —
# so an ambient root credential store can never silently answer for a fetch
# whose output is built and run as root (security review). The token block
# below APPENDS its scoped helper to this.
GIT_CRED_ARGS=(-c credential.helper=)
# GIT_SAFE_DIR: the safe.directory the wrapper passes — the deploy clone by
# default; the harness channel points it at its own clone (ADR-073). Read at
# CALL time, so the __verify-tag test hook's DEPLOY_DIR reassignment holds.
GIT_SAFE_DIR=""
git() { command git -c safe.directory="${GIT_SAFE_DIR:-${DEPLOY_DIR}}" "${GIT_CRED_ARGS[@]}" "$@"; }

# verify_tag <tag> — refuse anything we cannot attribute to an ALLOWED signer.
#
# `git verify-tag` alone is NOT sufficient: with GPG it exits 0 for a
# good-but-untrusted signature, so any key ever imported into root's keyring
# passes, and git never compares signer to tagger (verified empirically —
# security review). The SSH path DOES enforce an allowlist and fails closed
# when unconfigured, so that is the supported path and we ASSERT it is
# configured rather than relying on root's ambient gitconfig.
# ALLOWED_SIGNERS is a PINNED path, deliberately not read from root's gitconfig:
# the systemd unit sets ProtectHome=yes, so /root/.gitconfig is unreadable under
# the timer and `git config --global --get` returns empty there. That failed
# closed on every tick while a hand-run `sudo styrman-update` passed — the worst
# shape of bug, since it only appears after the operator enables the timer
# (review finding).
ALLOWED_SIGNERS="${STYRMAN_ALLOWED_SIGNERS:-/etc/styrman/allowed_signers}"

# verify_tag <tag> — returns non-zero rather than exiting, so callers inside an
# `if` condition (deploy) can take their own failure path.
verify_tag() {
    local tag="$1"
    [ "${REQUIRE_SIGNED}" = "1" ] || return 0
    # A lightweight tag is just a ref — it cannot carry a signature at all.
    if [ "$(git cat-file -t "${tag}" 2>/dev/null)" != "tag" ]; then
        log "REFUSED: ${tag} is a lightweight tag and cannot be verified. Re-tag with \`git tag -s ${tag}\` (signed, annotated), or opt out in /etc/styrman/update.env."
        return 1
    fi
    # REQUIRE an SSH signature. `-c gpg.format=ssh` does NOT force the SSH
    # verifier: git picks it from the signature's own armor header, so a
    # PGP-signed tag ignores the allowlist entirely and verifies against
    # whatever is in root's keyring — good-but-untrusted included (measured).
    # Only the SSH path consults gpg.ssh.allowedSignersFile, so anything else
    # is refused rather than silently unpinned.
    # Take the LAST armor header, matching git's own parse_signature: the tag
    # MESSAGE is author-controlled and `git cat-file tag` prints it, so a decoy
    # "-----BEGIN SSH SIGNATURE-----" line in the message passed a plain grep
    # while the real PGP block appended at the end still won — verify-tag then
    # exited 0 with the allowlist never consulted (security review reproduced
    # it). Comparing the last header closes that.
    # ALL FOUR of git's signature markers (gpg-interface.c: PGP SIGNATURE,
    # PGP MESSAGE, SIGNED MESSAGE for x509, SSH SIGNATURE) — the grep used to
    # know two, so an SSH block followed by a PGP MESSAGE block passed this
    # check while git verified with gpg (audit 2026-09-13).
    if [ "$(git cat-file tag "${tag}" 2>/dev/null |
            grep -E '^-----BEGIN (SSH SIGNATURE|PGP SIGNATURE|PGP MESSAGE|SIGNED MESSAGE)-----' | tail -1)" \
         != '-----BEGIN SSH SIGNATURE-----' ]; then
        log "REFUSED: ${tag} is not SSH-signed. Only SSH signatures are checked against the"
        log "  signer allowlist (${ALLOWED_SIGNERS}); a PGP signature would verify against any"
        log "  key in root's keyring and pin nothing. Re-tag with SSH signing:"
        log "    git config gpg.format ssh && git config user.signingkey ~/.ssh/id_ed25519.pub"
        return 1
    fi
    # Root-owned, literally — the file decides whose tags run as root. Only
    # the gated __verify-tag test hook, which runs unelevated, may accept its
    # own user's file instead (security review, 2026-09-13).
    local want_owner=0
    [ "${STYRMAN_UPDATE_TEST:-}" = 1 ] && want_owner="$(id -u)"
    if [ -r "${ALLOWED_SIGNERS}" ] && { [ "$(stat -c %u "${ALLOWED_SIGNERS}")" != "${want_owner}" ] ||
         [ -n "$(find "${ALLOWED_SIGNERS}" -perm /022 2>/dev/null)" ]; }; then
        log "REFUSED: ${ALLOWED_SIGNERS} must be root-owned and not group/world-writable —"
        log "  it decides whose tags this host will build and run as root."
        return 1
    fi
    if [ ! -r "${ALLOWED_SIGNERS}" ]; then
        log "REFUSED: ${ALLOWED_SIGNERS} is missing or unreadable, so no signer allowlist exists."
        log "  A bare \`git verify-tag\` accepts ANY key in root's keyring, so this is fatal by design."
        log "  Create it:  printf '%s %s\\n' <your-git-email> \"\$(cat ~/.ssh/id_ed25519.pub)\" | sudo tee ${ALLOWED_SIGNERS}"
        return 1
    fi
    # An EMPTY GNUPGHOME for the verification itself: should git ever
    # dispatch to gpg/gpgsm despite the marker check, no keyring means no
    # "good" signature — the timer's ProtectHome=yes gave that by accident,
    # a hand-run `sudo styrman-update` did not (audit 2026-09-13). The
    # RETURN trap removes the dir on every exit path of this function.
    # Script-scope (not local) so the RETURN trap reads it when it fires —
    # never expanded into the trap string, where a quote in TMPDIR would be
    # evaluated as root (security review, 2026-09-13).
    VERIFY_GNUPGHOME="$(mktemp -d)" || { log "REFUSED: cannot create a scratch GNUPGHOME"; return 1; }
    # shellcheck disable=SC2016  # single quotes on purpose: expanded at fire time
    trap 'rm -rf "${VERIFY_GNUPGHOME}"' RETURN
    if ! GNUPGHOME="${VERIFY_GNUPGHOME}" git -c gpg.ssh.allowedSignersFile="${ALLOWED_SIGNERS}" verify-tag "${tag}" 2>&1; then
        log "REFUSED: ${tag} is not signed by an allowed signer — will not build and run it as root."
        return 1
    fi
    log "${tag} signature OK (allowed signer)"
}

# ─── Harness channel (ADR-073): styrman-update harness [--check] [--force] ──
# The host-side, signature-gated delivery of styrman-harness to every project
# VM (plan .agents/docs/plans/2026-09-16-harness-channel.md): fetch the harness
# clone, walk its vX.Y.Z tags DOWNWARD from the newest to the first that
# verifies — verify_tag above, the same allowlist and the same refusals —
# never below the installed version, export it as a plain copy plus a sh-agent
# built offline in the Go builder image image/Dockerfile pins, smoke it inside
# the deployed runtime image as an unprivileged user, and swap
# ${HARNESS_DIR}/current by one rename. The server bind-mounts current
# read-only into every project VM. Every refusal is an ALARM: a REFUSED line
# here and a line in ${STATE_DIR}/harness-refused, which styrman-ctl status
# reports as DEGRADED. Unlike crew's own deploy this mode has NO unsigned
# opt-out (REQUIRE_SIGNED is forced to 1 in harness_main): what it installs
# runs in every project. Two entry points: the production one after the
# preamble (root, the ADR-052 state dir, the deploy clone's trust checks, the
# shared lock), and a test one beside __verify-tag (STYRMAN_UPDATE_TEST=1,
# every path a scratch path, unelevated — internal/config/styrman_harness_test.go).
HARNESS_REPO_DIR="${STYRMAN_HARNESS_REPO_DIR:-}"
HARNESS_DIR="${STYRMAN_HARNESS_DIR:-}"
HARNESS_GH_TOKEN_FILE="${STYRMAN_HARNESS_GH_TOKEN_FILE:-/etc/styrman/gh-token-harness}"
HARNESS_SMOKE_IMAGE="${STYRMAN_HARNESS_SMOKE_IMAGE:-}"   # honoured in test mode only
MODE=""

hlog() { log "harness: $*"; }

# ver_gt A B — A is a strictly higher vX.Y.Z than B (sort -V order).
ver_gt() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }

# harness_alarm <tag> <reason> — the REFUSED line and the marker file, capped
# at the newest 50 lines, written through a temp file so a reader never sees
# a partial line.
harness_alarm() {
    local tag="$1" reason="$2"
    log "harness: REFUSED: ${tag} — ${reason}"
    { cat "${HARNESS_REFUSED}" 2>/dev/null || true; printf '%s %s %s\n' "$(date -u +%FT%TZ)" "${tag}" "${reason}"; } \
        | tail -n 50 > "${HARNESS_REFUSED}.new.$$" && mv -f "${HARNESS_REFUSED}.new.$$" "${HARNESS_REFUSED}" \
        || log "WARN: could not write ${HARNESS_REFUSED}"
}

# harness_test_guard — STYRMAN_UPDATE_TEST=1 lets this mode run unelevated,
# but only against scratch paths: nothing under the host's real trees.
harness_test_guard() {
    local p
    for p in "${STATE_DIR}" "${HARNESS_DIR}" "${HARNESS_REPO_DIR}"; do
        case "${p}" in
            /|/etc|/etc/*|/var/lib/styrman|/var/lib/styrman/*|/opt|/opt/*|/usr|/usr/*|/root|/root/*|/run|/run/*)
                fail "test mode refuses ${p} — every path must be a scratch path" ;;
        esac
    done
    [ -n "${HARNESS_SMOKE_IMAGE}" ] || fail "test mode needs STYRMAN_HARNESS_SMOKE_IMAGE (the runtime image the smoke runs in)"
}

# harness_export <tag> — into ${HARNESS_DIR}/.tmp-<commit>: repo/ (the tag's
# tree minus .agents, .gitignore and any .git, plus COMMIT, TAG and SHA256SUMS
# in the mirror's shape — image/harness/VENDORED.md § Refresh) and
# bin/sh-agent built offline. Sets EXPORT_TMP and EXPORT_COMMIT; on failure
# EXPORT_ERR names the reason and the temp dir is gone.
harness_export() {
    local tag="$1" c tmp why
    EXPORT_ERR=""; EXPORT_TMP=""; EXPORT_COMMIT=""
    c="$(git rev-parse "${tag}^{commit}" 2>/dev/null)" || { EXPORT_ERR="cannot resolve ${tag}"; return 1; }
    tmp="${HARNESS_DIR}/.tmp-${c}"
    rm -rf "${tmp}"
    mkdir -p "${tmp}/repo" "${tmp}/bin" || { EXPORT_ERR="cannot create ${tmp}"; return 1; }
    if ! git archive --format=tar "${tag}" | tar -x -C "${tmp}/repo"; then
        rm -rf "${tmp}"; EXPORT_ERR="git archive ${tag} failed"; return 1
    fi
    rm -rf "${tmp}/repo/.agents" "${tmp}/repo/.gitignore" "${tmp}/repo/.git"
    if [ -n "$(find "${tmp}" -type l -print -quit 2>/dev/null)" ]; then
        rm -rf "${tmp}"; EXPORT_ERR="export failed: a symlink inside the tree (a plain copy carries none)"; return 1
    fi
    printf '%s' "${c}" > "${tmp}/repo/COMMIT"
    printf '%s' "${tag}" > "${tmp}/repo/TAG"
    ( cd "${tmp}/repo" && find . -type f ! -name SHA256SUMS | sed 's#^\./##' | LC_ALL=C sort | xargs sha256sum > SHA256SUMS ) \
        || { rm -rf "${tmp}"; EXPORT_ERR="export failed: SHA256SUMS"; return 1; }
    # The same build line as image/Dockerfile's harness-builder stage, in the
    # same pinned image, offline (the harness has no dependencies), as the
    # invoking user so the output is ours to own and remove.
    hlog "building sh-agent for ${tag} in ${HARNESS_BUILDER}"
    if ! docker run --rm --user "$(id -u):$(id -g)" --network none --cap-drop ALL --security-opt no-new-privileges \
            --read-only --tmpfs /tmp \
            -v "${tmp}/repo:/src:ro" -v "${tmp}/bin:/out" -w /src \
            -e HOME=/tmp -e GOCACHE=/tmp/gocache -e CGO_ENABLED=0 -e GOTOOLCHAIN=local -e GOPROXY=off \
            "${HARNESS_BUILDER}" go build -trimpath -ldflags='-s -w' -o /out/sh-agent ./cmd/sh-agent >"${tmp}/build.log" 2>&1; then
        why="$(tail -1 "${tmp}/build.log" | tr -cd '[:print:]' | cut -c1-200)"
        rm -rf "${tmp}"; EXPORT_ERR="build failed: ${why}"; return 1
    fi
    rm -f "${tmp}/build.log"
    find "${tmp}" -type d -exec chmod 755 {} + && find "${tmp}/repo" -type f -exec chmod 644 {} + && chmod 755 "${tmp}/bin/sh-agent" \
        || { rm -rf "${tmp}"; EXPORT_ERR="export failed: chmod"; return 1; }
    EXPORT_TMP="${tmp}"; EXPORT_COMMIT="${c}"
    return 0
}

# harness_smoke <tmp> — the candidate as a project would see it: mounted
# read-only into the runtime image, as uid 1000, `list` and a dry-run install
# into a scratch home. Exit codes only; the counts are logged, never asserted
# (a harness release that adds a skill needs no crew change).
harness_smoke() {
    local tmp="$1" home out
    SMOKE_ERR=""
    # The scratch home lives under the root-owned content dir, never on the
    # shared /tmp (a world-writable home there would let any local user fail
    # a good tag into the latch — review 2026-09-16), and is owned by the
    # uid the smoke runs as: 1000 in production, the invoking user in test
    # mode (SMOKE_UID, set by harness_main).
    home="$(mktemp -d "${HARNESS_DIR}/.smoke-XXXXXX")" || { SMOKE_ERR="smoke failed: cannot create a scratch home"; return 1; }
    if [ "${SMOKE_UID}" != "$(id -u):$(id -g)" ] && ! chown "${SMOKE_UID}" "${home}"; then
        rm -rf "${home}"; SMOKE_ERR="smoke failed: cannot hand the scratch home to uid ${SMOKE_UID}"; return 1
    fi
    if out="$(docker run --rm --user "${SMOKE_UID}" --network none --cap-drop ALL --security-opt no-new-privileges -e HOME=/home/u \
            -v "${tmp}/repo:/styrman/harness:ro" -v "${tmp}/bin/sh-agent:/styrman/bin/sh-agent:ro" -v "${home}:/home/u" \
            --entrypoint sh "${HARNESS_SMOKE_IMAGE}" \
            -c '/styrman/bin/sh-agent list --repo /styrman/harness && /styrman/bin/sh-agent install --dry-run --repo /styrman/harness --home /home/u' 2>&1)"; then
        rm -rf "${home}"
        printf '%s\n' "${out}" | grep -E '^### (Skills|Subagents)' | tr -cd '[:print:]\n' | cut -c1-120 \
            | while IFS= read -r line; do hlog "  smoke: ${line}"; done
        return 0
    fi
    rm -rf "${home}"
    SMOKE_ERR="smoke failed: $(printf '%s\n' "${out}" | tail -1 | tr -cd '[:print:]' | cut -c1-200)"
    return 1
}

# harness_swap <tmp> <commit> <tag> — the content dir takes the commit's name,
# current is replaced by ONE rename, the previous target is kept beside it and
# older ones removed, the state files follow. The failed-tag latch is cleared
# only by a tag at or above the failed one: a lower tag installed under it
# must not make the next tick retry the broken release.
harness_swap() {
    local tmp="$1" c="$2" tag="$3" dst prev_target d base failed
    dst="${HARNESS_DIR}/${c}"
    prev_target="$(readlink "${HARNESS_DIR}/current" 2>/dev/null || true)"
    if [ -e "${dst}" ]; then   # --force: the same commit exported again
        rm -rf "${dst}".prev-* 2>/dev/null || true
        mv -T "${dst}" "${dst}.prev-$(date +%s)" || { rm -rf "${tmp}"; return 1; }
    fi
    mv -T "${tmp}" "${dst}" || { rm -rf "${tmp}"; return 1; }
    ln -s "${c}" "${HARNESS_DIR}/current.new.$$" && mv -T "${HARNESS_DIR}/current.new.$$" "${HARNESS_DIR}/current" \
        || { rm -f "${HARNESS_DIR}/current.new.$$"; return 1; }
    printf '%s' "${tag}" > "${HARNESS_STATE}.new.$$" && mv -f "${HARNESS_STATE}.new.$$" "${HARNESS_STATE}"
    printf '%s' "${c}" > "${HARNESS_SHA}.new.$$" && mv -f "${HARNESS_SHA}.new.$$" "${HARNESS_SHA}"
    failed="$(cat "${HARNESS_FAILED}" 2>/dev/null || true)"
    if [ -n "${failed}" ] && ! ver_gt "${failed}" "${tag}"; then rm -f "${HARNESS_FAILED}"; fi
    # Dot-dirs are named explicitly: a bare glob skips them (no dotglob),
    # which left interrupted exports' .tmp-* behind (review 2026-09-16).
    for d in "${HARNESS_DIR}"/* "${HARNESS_DIR}"/.tmp-* "${HARNESS_DIR}"/.smoke-*; do
        [ -e "${d}" ] || continue
        base="$(basename "${d}")"
        case "${base}" in
            current|current.new.*|"${c}"|"${c}".prev-*) continue ;;
            .tmp-*|.smoke-*) rm -rf "${d}"; continue ;;
        esac
        [ -n "${prev_target}" ] && case "${base}" in "${prev_target}"|"${prev_target}".prev-*) continue ;; esac
        if printf '%s' "${base}" | grep -qE '^[0-9a-f]{40}(\.prev-[0-9]+)?$'; then rm -rf "${d}"; fi
    done
    return 0
}

harness_main() {
    local want_owner=0 testmode=0 tags t first=1 dv
    [ -n "${HARNESS_REPO_DIR}" ] || fail "STYRMAN_HARNESS_REPO_DIR is not set (styrman-harness-update.service sets it)"
    [ -n "${HARNESS_DIR}" ] || fail "STYRMAN_HARNESS_DIR is not set (styrman-harness-update.service sets it)"
    HARNESS_DIR="$(realpath -m -- "${HARNESS_DIR}")" || fail "cannot canonicalize STYRMAN_HARNESS_DIR"
    HARNESS_REPO_DIR="$(realpath -m -- "${HARNESS_REPO_DIR}")" || fail "cannot canonicalize STYRMAN_HARNESS_REPO_DIR"
    case "${HARNESS_DIR}" in
        /var/lib/styrman) fail "STYRMAN_HARNESS_DIR=${HARNESS_DIR} is the state root itself — use a dedicated dir below it, e.g. /var/lib/styrman/harness" ;;
        /) fail "STYRMAN_HARNESS_DIR=/ — refusing" ;;
        /*/*) : ;;
        /*) fail "STYRMAN_HARNESS_DIR=${HARNESS_DIR} is a top-level directory — refusing; use a dedicated dir, e.g. /var/lib/styrman/harness" ;;
        *) fail "STYRMAN_HARNESS_DIR must be an absolute path" ;;
    esac
    SMOKE_UID="1000:1000"
    if [ "${STYRMAN_UPDATE_TEST:-}" = 1 ]; then testmode=1; want_owner="$(id -u)"; SMOKE_UID="$(id -u):$(id -g)"; harness_test_guard; fi
    # The content dir is the trust boundary — its parent /var/lib/styrman is
    # operator-owned by design (host-setup.sh) — so: never a symlink, owned by
    # us, no group/world write, every run.
    [ ! -L "${HARNESS_DIR}" ] || fail "${HARNESS_DIR} is a symlink — refusing"
    [ -d "${HARNESS_DIR}" ] || install -d -m 755 "${HARNESS_DIR}" || fail "cannot create ${HARNESS_DIR}"
    [ "$(stat -c %u "${HARNESS_DIR}")" = "${want_owner}" ] \
        || fail "${HARNESS_DIR} is not owned by uid ${want_owner} — refusing to write the harness every project mounts"
    [ -z "$(find "${HARNESS_DIR}" -maxdepth 0 -perm /022 2>/dev/null)" ] || fail "${HARNESS_DIR} is group/world-writable — refusing"
    HARNESS_STATE="${STATE_DIR}/harness-version"; HARNESS_SHA="${STATE_DIR}/harness-sha"
    HARNESS_FAILED="${STATE_DIR}/harness-failed-version"; HARNESS_REFUSED="${STATE_DIR}/harness-refused"
    if [ -e "${HARNESS_DIR}/current" ] && [ ! -L "${HARNESS_DIR}/current" ]; then
        harness_alarm current "${HARNESS_DIR}/current is a real directory, not a symlink — a planted bind source? refusing until it is removed"
        fail "${HARNESS_DIR}/current is not a symlink"
    fi
    INSTALLED="$(cat "${HARNESS_STATE}" 2>/dev/null || true)"
    if [ -n "${INSTALLED}" ] && ! printf '%s' "${INSTALLED}" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
        log "WARN: ignoring malformed ${HARNESS_STATE} contents"; INSTALLED=""
    fi
    [ -n "${INSTALLED}" ] || INSTALLED=none
    HARNESS_FAILED_TAG="$(cat "${HARNESS_FAILED}" 2>/dev/null || true)"
    if [ "${FORCE}" = true ] && [ "${INSTALLED}" = none ]; then hlog "--force ignored: nothing installed yet"; FORCE=false; fi
    # The harness clone: its own safe.directory and its own token; the crew
    # token is never used here.
    [ -d "${HARNESS_REPO_DIR}/.git" ] || fail "no harness clone at ${HARNESS_REPO_DIR} (styrman-ctl update --setup clones it)"
    if [ "${testmode}" = 0 ]; then
        trusted_dir "${HARNESS_REPO_DIR}" \
            || fail "${HARNESS_REPO_DIR} is not a root-owned directory without group/world write — refusing to build from a tree another user can write"
        [ "$(stat -c %u "${HARNESS_REPO_DIR}/.git" 2>/dev/null)" = "0" ] || fail "${HARNESS_REPO_DIR}/.git is not root-owned — refusing"
        [ -z "$(find "${HARNESS_REPO_DIR}/.git" -maxdepth 0 -perm /022 2>/dev/null)" ] || fail "${HARNESS_REPO_DIR}/.git is group/world-writable — refusing"
        if [ -f "${HARNESS_GH_TOKEN_FILE}" ]; then
            [ "$(stat -c %u "${HARNESS_GH_TOKEN_FILE}")" = "0" ] \
                || fail "${HARNESS_GH_TOKEN_FILE} is not root-owned — refusing to authenticate with a token another user controls"
            [ -z "$(find "${HARNESS_GH_TOKEN_FILE}" -perm /077 2>/dev/null)" ] \
                || fail "${HARNESS_GH_TOKEN_FILE} is readable or writable beyond root (chmod 600 it)"
            export HARNESS_GH_TOKEN_FILE
            GIT_CRED_ARGS+=(-c 'credential.https://github.com.helper=!f() { echo username=x-access-token; printf "password=%s\n" "$(cat "${HARNESS_GH_TOKEN_FILE}")"; }; f')
        fi
        dv="$(cat "${STATE_DIR}/deployed-version" 2>/dev/null || true)"
        printf '%s' "${dv}" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+$' \
            || fail "no deployed crew version in ${STATE_DIR}/deployed-version — the smoke needs the deployed runtime image; deploy crew first"
        HARNESS_SMOKE_IMAGE="styrman-runtime:${dv#v}"
    fi
    GIT_SAFE_DIR="${HARNESS_REPO_DIR}"
    cd "${HARNESS_REPO_DIR}" || fail "cannot cd to ${HARNESS_REPO_DIR}"
    REQUIRE_SIGNED=1   # no opt-out on this path: what it installs runs in every project VM
    HARNESS_BUILDER="$(sed -n 's/^FROM \(golang:[^ ]*\) AS harness-builder$/\1/p' "${DEPLOY_DIR}/image/Dockerfile")"
    [ -n "${HARNESS_BUILDER}" ] || fail "no harness-builder FROM line in ${DEPLOY_DIR}/image/Dockerfile"
    if ! git fetch --tags --force --prune --prune-tags origin 2>&1; then
        fail "git fetch failed — root cannot reach ${HARNESS_REPO_DIR}'s origin. For a private repo: mint a FINE-GRAINED GitHub token (styrman-harness only, Contents: Read-only) and install it at ${HARNESS_GH_TOKEN_FILE} (root:root, chmod 600); the origin must be an https:// URL. Expired token? Fine-grained tokens have an expiry — mint a fresh one."
    fi
    tags="$(git tag -l 'v*' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -Vr || true)"
    if [ -z "${tags}" ]; then hlog "no vX.Y.Z tag yet — waiting for the first signed release (installed: ${INSTALLED})"; return 0; fi
    [ "${FORCE}" = false ] || tags="${INSTALLED}"
    for t in ${tags}; do
        if [ "${FORCE}" = false ] && [ "${INSTALLED}" != none ] && ! ver_gt "${t}" "${INSTALLED}"; then
            if [ "${first}" = 1 ] && ver_gt "${INSTALLED}" "${t}"; then
                harness_alarm "${t}" "below the installed ${INSTALLED} (a deleted or moved tag?) — keeping ${INSTALLED}"
            fi
            break
        fi
        first=0
        if [ "${FORCE}" = false ] && [ "${t}" = "${HARNESS_FAILED_TAG}" ]; then
            hlog "${t} previously failed export or smoke — skipped (latched; a newer tag clears it, --force retries the installed tag)"; continue
        fi
        if ! verify_tag "${t}"; then harness_alarm "${t}" "not verified (the REFUSED line above says why)"; continue; fi
        if [ "${CHECK_ONLY}" = true ]; then hlog "update AVAILABLE: ${INSTALLED} → ${t} (--check changes nothing)"; return 0; fi
        if ! harness_export "${t}"; then
            harness_alarm "${t}" "${EXPORT_ERR}"; printf '%s' "${t}" > "${HARNESS_FAILED}"; continue
        fi
        if ! harness_smoke "${EXPORT_TMP}"; then
            harness_alarm "${t}" "${SMOKE_ERR}"; rm -rf "${EXPORT_TMP}"; printf '%s' "${t}" > "${HARNESS_FAILED}"; continue
        fi
        harness_swap "${EXPORT_TMP}" "${EXPORT_COMMIT}" "${t}" || fail "swap of ${t} failed — ${HARNESS_DIR}/current unchanged"
        hlog "${t} (${EXPORT_COMMIT:0:7}) is current"
        return 0
    done
    hlog "nothing newer than ${INSTALLED} verifies"
    return 0
}

# ─── Test hook: styrman-update __verify-tag <tag> <allowed_signers> <repo> ──
# Runs verify_tag against a scratch repo and allowed_signers, as a non-root
# user, without the fetch/deploy flow — only under the Go test
# (internal/config/styrman_update_test.go), which sets STYRMAN_UPDATE_TEST=1;
# anything else is refused before it can bypass the root and state guards.
if [ "${1:-}" = "__verify-tag" ]; then
    [ "${STYRMAN_UPDATE_TEST:-}" = 1 ] || fail "internal test hooks are disabled (set STYRMAN_UPDATE_TEST=1 only under the Go test)"
    [ $# -eq 4 ] || fail "usage: __verify-tag <tag> <allowed_signers> <repo>"
    REQUIRE_SIGNED=1
    ALLOWED_SIGNERS="$3"
    DEPLOY_DIR="$4"
    cd "$4" || fail "cannot cd to $4"
    if verify_tag "$2"; then exit 0; else exit 1; fi
fi
# The harness channel under the same test gate: unelevated, scratch paths only
# (harness_test_guard), the smoke image from STYRMAN_HARNESS_SMOKE_IMAGE.
if [ "${1:-}" = harness ] && [ "${STYRMAN_UPDATE_TEST:-}" = 1 ]; then
    shift
    CHECK_ONLY=false; FORCE=false
    for arg in "$@"; do
        case "${arg}" in --check) CHECK_ONLY=true ;; --force) FORCE=true ;; *) fail "unknown flag: ${arg}" ;; esac
    done
    [ -n "${STATE_DIR}" ] || fail "STYRMAN_UPDATE_STATE_DIR is not set — tests pass a NESTED scratch path (ADR-052)"
    STATE_DIR="$(realpath -m -- "${STATE_DIR}")" || fail "cannot canonicalize STYRMAN_UPDATE_STATE_DIR"
    mkdir -p "${STATE_DIR}" || fail "cannot create ${STATE_DIR}"
    harness_main; exit $?
fi

CHECK_ONLY=false
FORCE=false
for arg in "$@"; do
    case "${arg}" in
        --check) CHECK_ONLY=true ;;
        --force) FORCE=true ;;
        harness) MODE=harness ;;   # the harness channel (ADR-073) — dispatched after the preamble below
        *) echo "unknown flag: ${arg}" >&2; exit 2 ;;
    esac
done


[ "$(id -u)" -eq 0 ] || fail "must run as root"
# ADR-052: no production-path default outside the systemd unit. Production runs
# go through `systemctl start styrman-update.service` (the unit pins
# /etc/styrman/update); a hand-run must pick its state dir explicitly, and a
# TEST run must pass a scratch prefix that cannot alias production state.
[ -n "${STATE_DIR}" ] || fail "STYRMAN_UPDATE_STATE_DIR is not set — production: systemctl start styrman-update.service (or pass /etc/styrman/update explicitly); tests: pass a NESTED scratch path, e.g. \$(mktemp -d)/state (ADR-052)"
# Canonicalize before the refusal check: //var/lib/styrman, relative paths and
# symlinked aliases must not slip past a literal prefix match (security review).
STATE_DIR="$(realpath -m -- "${STATE_DIR}")" || fail "cannot canonicalize STYRMAN_UPDATE_STATE_DIR"
case "${STATE_DIR}" in
    /var/lib/styrman|/var/lib/styrman/*)
        # Operator-owned production data — both the ADR-052 incident path and
        # the deployed-sha trust hole the security review closed.
        fail "STYRMAN_UPDATE_STATE_DIR=${STATE_DIR} is inside /var/lib/styrman — refusing (ADR-052)" ;;
esac
# A shared system directory is not a state dir. The ADR-052 guard only checked
# the /var/lib/styrman prefix, so a ONE-COMPONENT typo off the recommended
# /etc/styrman/update — "/etc", or a bare "/" — passed it cleanly (root-owned,
# 0755, no group/world-write bits) and scattered deployed-version, deployed-sha
# and failed-version into a shared dir where nothing would ever find them
# (audit 2026-09-02). Require a dedicated nested path: at least two components,
# and never a bare top-level directory.
case "${STATE_DIR}" in
    /) fail "STYRMAN_UPDATE_STATE_DIR=/ is the filesystem root — refusing; use a dedicated dir, e.g. /etc/styrman/update" ;;
    /*/*) : ;; # two or more components — fine
    /*)  fail "STYRMAN_UPDATE_STATE_DIR=${STATE_DIR} is a top-level system directory — refusing; use a dedicated dir, e.g. /etc/styrman/update" ;;
    *)   fail "STYRMAN_UPDATE_STATE_DIR=${STATE_DIR} must be an absolute path" ;;
esac
STATE="${STATE_DIR}/deployed-version"
STATE_SHA="${STATE_DIR}/deployed-sha"
FAILED="${STATE_DIR}/failed-version"
# docker CLI config: ephemeral and EMPTY on every run. Under the unit systemd
# provides a per-run tmpfs dir (RuntimeDirectory); a hand-run gets a mktemp
# dir removed on exit. Never root's /root/.docker (ProtectHome makes it vanish
# under the timer, so timer and hand-run builds differed) and never the state
# dir (root-executed inputs nobody asserts) — code review 2026-09-02.
# Only a systemd-provided RuntimeDirectory (under /run) is honoured: an
# inherited value from a `sudo -E` hand-run would re-open the root-executed
# config/plugin surface this exists to remove (security review).
case "${DOCKER_CONFIG:-}" in
    /run/*)
        # Same trust bar as every other root input: /run/lock is 1777 and
        # /run/user/<uid> is uid-owned, so the path shape alone proves nothing
        # (security review). The unit's RuntimeDirectory is root 0700; its
        # docker/ leaf may not exist yet — assert the nearest existing dir.
        _dc="${DOCKER_CONFIG}"
        while [ ! -d "${_dc}" ]; do _dc="$(dirname "${_dc}")"; done
        [ "$(stat -c %u "${_dc}")" = "0" ] \
            || fail "DOCKER_CONFIG=${DOCKER_CONFIG} is not root-owned — refusing a docker config another user controls"
        [ -z "$(find "${_dc}" -maxdepth 0 -perm /022 2>/dev/null)" ] \
            || fail "DOCKER_CONFIG=${DOCKER_CONFIG} is group/world-writable — refusing"
        ;;
    *)
        DOCKER_CONFIG="$(mktemp -d)"
        # The script's ONLY trap: anyone adding another EXIT trap must chain
        # this cleanup, not replace it (review note).
        trap 'rm -rf "${DOCKER_CONFIG}"' EXIT ;;
esac
export DOCKER_CONFIG
[ -d "${DEPLOY_DIR}/.git" ] || fail "no deploy clone at ${DEPLOY_DIR} (see host-setup.sh step 8c)"
# compose reads this for the ingress token, uid/gid, &c. The updater no longer
# reads it itself (the version check uses a container label), but a build
# without it produces a broken stack.
[ -f "${DEPLOY_DIR}/deploy/.env" ] || fail "${DEPLOY_DIR}/deploy/.env missing — the deploy clone needs its own secrets file"

# Serialize: a build can outlast the timer interval, and two concurrent
# checkouts of the same tree would corrupt each other. (The argolis original
# had no lock and its 5-minute timer could stack.)
# -m with -p only applies to the deepest dir (SC2174), so create the parent
# explicitly: a fresh /etc/styrman must be 0700 too, not just the leaf. Create
# ONLY what is missing — `install -d` re-modes an EXISTING dir, and with the
# state dir now caller-chosen (ADR-052) that turned a root `--check` against
# $(mktemp -d) into chmod 0700 root:root of /tmp itself (review+security
# finding, measured). An existing dir's ownership/mode is asserted below, not
# forced here.
STATE_PARENT="$(dirname "${STATE_DIR}")"
[ -d "${STATE_PARENT}" ] || install -d -m 700 -o root -g root "${STATE_PARENT}" || fail "cannot create ${STATE_PARENT}"
[ -d "${STATE_DIR}" ] || install -d -m 700 -o root -g root "${STATE_DIR}" || fail "cannot create ${STATE_DIR}"
# The rollback trusts deployed-sha enough to skip verification, so the dir it
# lives in gets the same ownership+mode guarantee as every other trust input.
[ "$(stat -c %u "${STATE_DIR}")" = "0" ] \
    || fail "${STATE_DIR} is not root-owned — refusing to trust the recorded deploy state"
[ -z "$(find "${STATE_DIR}" -maxdepth 0 -perm /022 2>/dev/null)" ] \
    || fail "${STATE_DIR} is group/world-writable — refusing to trust the recorded deploy state"
exec 9>"${LOCK}"
flock -n 9 || { log "another run is in progress — skipping this tick"; exit 0; }

cd "${DEPLOY_DIR}"
# git refuses to operate on a tree owned by another user. Pass it per-command
# with `git -c` instead of `git config --global --add`, which never
# de-duplicates and grew /root/.gitconfig by one line every tick — ~105k lines
# a year at this cadence (review finding).
# Assert the clone is root-owned BEFORE disabling git's ownership guard for it:
# `-c safe.directory` on a tree someone else can write would let them choose the
# code this script builds as root (security review).
# The WORKTREE ROOT first, then .git. The comment above names the threat as
# "a tree someone else can write", and git's ownership guard covers the
# repository, not the checked-out files that `docker build` subsequently reads
# as its build context — nor a gitignored plant, which `git clean -d` (no -x)
# preserves. Asserting only .git left exactly that gap (audit 2026-09-08).
trusted_dir "${DEPLOY_DIR}" \
    || fail "${DEPLOY_DIR} is not a root-owned directory without group/world write — refusing to build from a tree another user can write"
[ "$(stat -c %u "${DEPLOY_DIR}/.git" 2>/dev/null)" = "0" ] \
    || fail "${DEPLOY_DIR}/.git is not root-owned — refusing to build from a tree another user can write"
# Mode too: HEAD now also decides what is INSTALLED as root (self-install
# reads the git objects), so .git gets the same group/world-write bar as
# every other trust input (review).
[ -z "$(find "${DEPLOY_DIR}/.git" -maxdepth 0 -perm /022 2>/dev/null)" ] \
    || fail "${DEPLOY_DIR}/.git is group/world-writable — refusing to trust its objects"
# The harness channel leaves here: it shares the lock (a crew deploy and a
# harness tick never overlap), the state dir and the deploy clone's trust
# checks (it reads image/Dockerfile there), and never touches the crew token,
# the crew fetch, the crew LATEST or the update.env opt-out (ADR-073).
if [ "${MODE}" = harness ]; then
    harness_main
    exit $?
fi
# deploy/.env survives both `checkout --force` and `git clean -d` (it is
# gitignored) and supplies STYRMAN_ALLOWED_EMAILS to the stack, so it needs the
# same ownership guarantee as the tree itself (security review).
[ "$(stat -c %u "${DEPLOY_DIR}/deploy/.env" 2>/dev/null)" = "0" ] \
    || fail "${DEPLOY_DIR}/deploy/.env is not root-owned — refusing to deploy with credentials another user can write"
# Mode, not just owner: a root-owned 0666 passed an ownership-only check, and a
# root-owned 0644 leaks STYRMAN_INGRESS_TOKEN / STYRMAN_ALLOWED_EMAILS.
[ -z "$(find "${DEPLOY_DIR}/deploy/.env" -perm /077 2>/dev/null)" ] \
    || fail "${DEPLOY_DIR}/deploy/.env is readable or writable beyond root (chmod 600 it) — it holds the ingress token"
# The repo is PRIVATE and this runs as root. Auth is a FINE-GRAINED GitHub
# token (operator decision 2026-09-01: the host holds NO SSH key) — scoped to
# this ONE repository with Contents: Read-only, stored root-only at
# /etc/styrman/gh-token, fed to git over HTTPS via an inline credential
# helper. Never in the remote URL: a URL-embedded token lands in .git/config
# and every process listing. TLS to github.com replaces the SSH known_hosts
# trust anchor the old deploy-key path needed. GIT_TERMINAL_PROMPT=0 makes a
# missing/expired token FAIL FAST instead of hanging on a credential prompt —
# fine-grained tokens expire, and "cannot see new versions" must be loud
# (review finding: a fetch failure was once a single WARN in a long log).
export GIT_TERMINAL_PROMPT=0
GH_TOKEN_FILE="${STYRMAN_GH_TOKEN_FILE:-/etc/styrman/gh-token}"
# Exported so the helper below reads it from its OWN environment — the path is
# never interpolated into the git-evaluated shell string (security review: an
# unquoted interpolation made a path with spaces yield an empty password, and
# operator-env paths are a root shell-injection surface).
export GH_TOKEN_FILE
# GIT_CRED_ARGS starts as "no inherited helper" (see the functions block);
# the scoped GitHub helper is appended here when a token file exists.
if [ -f "${GH_TOKEN_FILE}" ]; then
    # Same trust bar as every other root input this script reads.
    [ "$(stat -c %u "${GH_TOKEN_FILE}")" = "0" ] \
        || fail "${GH_TOKEN_FILE} is not root-owned — refusing to authenticate with a token another user controls"
    [ -z "$(find "${GH_TOKEN_FILE}" -perm /077 2>/dev/null)" ] \
        || fail "${GH_TOKEN_FILE} is readable or writable beyond root (chmod 600 it)"
    # URL-SCOPED to https://github.com (security review, verified: an
    # unscoped helper hands the token to a probe for ANY host; the scoped
    # form fails closed elsewhere). Single-quoted: nothing expands here —
    # the helper resolves "$GH_TOKEN_FILE" from the exported env at run time.
    # shellcheck disable=SC2016
    GIT_CRED_ARGS+=(-c 'credential.https://github.com.helper=!f() { echo username=x-access-token; printf "password=%s\n" "$(cat "${GH_TOKEN_FILE}")"; }; f')
fi

# ─── Find the newest STABLE tag ─────────────────────────────────────────────
# --force so a re-tagged release is picked up; --prune-tags so a DELETED tag
# stops being a candidate (without it a withdrawn release would live forever
# in the local clone and keep reinstalling itself).
# Fail LOUDLY on a fetch error rather than silently deploying from stale local
# tags: "no new version" and "cannot see new versions" must not look identical.
if ! git fetch --tags --force --prune --prune-tags origin 2>&1; then
    fail "git fetch failed — root cannot reach ${DEPLOY_DIR}'s origin. For a private repo: mint a FINE-GRAINED GitHub token (this repo only, Contents: Read-only) and install it at ${GH_TOKEN_FILE} (root:root, chmod 600); the origin must be an https:// URL. Expired token? Fine-grained tokens have an expiry — mint a fresh one."
fi

# STRICTLY vX.Y.Z. Pre-releases (v1.16.0-rc1, -beta) are excluded by the
# anchored regex, so release candidates can be pushed without deploying them.
# sort -V picks the highest VERSION, not the most recently created tag.
LATEST="$(git tag -l 'v*' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1 || true)"
[ -n "${LATEST}" ] || fail "no stable vX.Y.Z tags found"

# ─── Tag integrity ──────────────────────────────────────────────────────────
# What this script does with a tag is check it out and BUILD IT AS ROOT, and
# docker-compose.yml lives inside that checkout — so a hostile revision only
# has to add a bind mount to own the host. Without a signature the trust set is
# "anyone who can push a tag" (account takeover, a future collaborator, a
# write-capable CI token), not "the operator" (security review, 2026-09-01).
#
# Fails CLOSED. Set STYRMAN_UPDATE_REQUIRE_SIGNED=0 in /etc/styrman/update.env
# to accept unsigned tags — a deliberate, root-only, logged choice.
#
# The opt-out is READ, not sourced. `. /etc/styrman/update.env` as root would
# execute whatever is in that file — and redefining log(){ :; } there would
# silence the "signature checking DISABLED" warning below, giving a silent
# skip path (security review). Ownership and mode are asserted first.
REQUIRE_SIGNED=1
if [ -f /etc/styrman/update.env ]; then
    if [ "$(stat -c '%u' /etc/styrman/update.env)" != "0" ]; then
        fail "/etc/styrman/update.env is not root-owned — refusing to read update policy from it"
    fi
    if [ -n "$(find /etc/styrman/update.env -perm /022 2>/dev/null)" ]; then
        fail "/etc/styrman/update.env is group/world-writable — refusing to read update policy from it"
    fi
    # Anchored: `...=0anything` must not disable it, and `export ...=0` must.
    if grep -qE '^[[:space:]]*(export[[:space:]]+)?STYRMAN_UPDATE_REQUIRE_SIGNED[[:space:]]*=[[:space:]]*"?0"?[[:space:]]*$' /etc/styrman/update.env; then
        REQUIRE_SIGNED=0
    fi
fi


if [ "${REQUIRE_SIGNED}" != "1" ]; then
    log "WARNING: signature checking DISABLED — any pushed tag will be built and run as root"
fi
verify_tag "${LATEST}" || fail "refusing to deploy ${LATEST} (see above)"

CURRENT="$(cat "${STATE}" 2>/dev/null || true)"
# The state file is root-owned, but a malformed value (notably a leading "-")
# would be read by git as an OPTION. Accept only the tag shape we write.
if [ -n "${CURRENT}" ] && ! printf '%s' "${CURRENT}" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
    log "WARN: ignoring malformed ${STATE} contents"
    CURRENT=""
fi
if [ -z "${CURRENT}" ]; then
    # First run: fall back to whatever the clone is checked out at.
    CURRENT="$(git describe --tags --exact-match 2>/dev/null || echo none)"
fi

log "deployed=${CURRENT} latest-stable=${LATEST}"

# The FAILED-tag latch, the "already up to date" exit and the --check exit
# moved below the function definitions (ADR-065): host_converge runs on
# EVERY tick — including no-op ticks and ticks after a failed release — and
# needs the helpers defined further down. Nothing between here and there has
# side effects; it is all definitions.

# ─── Self-install ───────────────────────────────────────────────────────────
# The updater deploys the container STACK from the verified checkout, but it
# lives outside that stack — this script in /usr/local/bin and the two units
# in /etc/systemd/system, put there by host-setup.sh — so a release that
# changed deploy/update/* used to deploy everything except the updater itself
# (bit the operator three times, 2026-09-01/02). After a deploy has been
# health-checked, install the checkout's copies: the running bash keeps its
# open (old) inode — the replacement is an atomic rename, never an in-place
# write — so the new script takes effect on the NEXT run.
# ADR-052: the targets have NO in-script default; the unit pins them, a
# hand-run or a test that does not set them gets a log line and no install.
UPDATER_BIN="${STYRMAN_UPDATER_BIN:-}"
UPDATER_UNIT_DIR="${STYRMAN_UPDATER_UNIT_DIR:-}"
SELF_HEAD="" # set by self_install: the verified commit its reads are pinned to
# atomic_install <mode> <git-path> <dst> — content comes from the VERIFIED
# git object at HEAD (`git show`), never from the worktree: the checkout is a
# mutable directory that a local user could edit between verification and
# install (security review). Temp file beside the target + rename = a new
# inode, so a running copy of the target is never modified in place; -T so a
# directory sitting at the target path fails instead of swallowing the file
# (review: mv -f onto a dir "succeeds" by moving the file inside it).
atomic_install() {
    local mode="$1" gitpath="$2" dst="$3"
    git show "${SELF_HEAD}:${gitpath}" > "${dst}.new.$$" \
        && chmod "${mode}" "${dst}.new.$$" && chown root:root "${dst}.new.$$" \
        && mv -fT "${dst}.new.$$" "${dst}" \
        || { rm -f "${dst}.new.$$"; return 1; }
}
# differs <git-path> <dst> — true when the verified object and the installed
# file differ (or the file is absent).
differs() { ! git show "${SELF_HEAD}:$1" 2>/dev/null | cmp -s - "$2" 2>/dev/null; }
self_install() {
    if [ -z "${UPDATER_BIN}" ] || [ -z "${UPDATER_UNIT_DIR}" ]; then
        log "self-install skipped: STYRMAN_UPDATER_BIN/STYRMAN_UPDATER_UNIT_DIR unset (the unit sets them)"
        return 0
    fi
    # Only a SIGNATURE-VERIFIED tree may replace the updater (security review):
    # with the REQUIRE_SIGNED opt-out engaged, the deployed tree is unverified
    # and must not become the thing that decides whether signatures are
    # checked next time. (The rollback path only skips re-verification for a
    # SHA this host verified when it was first deployed.)
    if [ "${REQUIRE_SIGNED}" != "1" ]; then
        log "self-install skipped: signature enforcement is OFF — an unverified tree must not replace the updater"
        return 0
    fi
    # Targets are root-written from env (unit-pinned): canonicalize, pin the
    # basenames, and assert the destination dirs like every other root input.
    local bin bindir unitdir src changed=0 failed=0 f
    bin="$(realpath -m -- "${UPDATER_BIN}")"; bindir="$(dirname "${bin}")"
    unitdir="$(realpath -m -- "${UPDATER_UNIT_DIR}")"
    if [ "$(basename "${bin}")" != "styrman-update" ]; then
        log "WARN: self-install skipped: STYRMAN_UPDATER_BIN must be named styrman-update (got ${bin})"; return 0
    fi
    if ! trusted_dir "${bindir}" || ! trusted_dir "${unitdir}"; then
        log "WARN: self-install skipped: ${bindir} or ${unitdir} is missing, not root-owned, or group/world-writable"; return 0
    fi
    # Pin the verified commit ONCE: every read below resolves against this
    # SHA, so an operator `git checkout` in the clone mid-run cannot yield a
    # mixed install (review).
    SELF_HEAD="$(git rev-parse HEAD 2>/dev/null)" || { log "WARN: cannot resolve HEAD — self-install skipped"; return 0; }
    src="deploy/update" # git paths, resolved against ${SELF_HEAD}
    for f in styrman-update styrman-update.service styrman-update.timer; do
        git cat-file -e "${SELF_HEAD}:${src}/${f}" 2>/dev/null || { log "WARN: ${src}/${f} missing in the verified tree — self-install skipped"; return 0; }
    done
    # The harness channel's unit pair (ADR-073) is OPTIONAL here: a verified
    # tree without it (a rollback to a pre-channel tag) skips those two files
    # and still installs the crew files, instead of the fail-closed return
    # above (cold read of the plan, round 2).
    local units=(styrman-update.service styrman-update.timer)
    for f in styrman-harness-update.service styrman-harness-update.timer; do
        if git cat-file -e "${SELF_HEAD}:${src}/${f}" 2>/dev/null; then units+=("${f}"); else log "self-install: ${src}/${f} not in the verified tree (pre-ADR-073 release) — skipped"; fi
    done
    log "self-install targets: ${bin}, ${unitdir}/{${units[*]}}"
    # Sweep orphans of ALL targets up front (an earlier SIGKILLed attempt),
    # not just the ones that drift this run (review).
    rm -f "${bin}.new."* 2>/dev/null || true
    for f in "${units[@]}"; do rm -f "${unitdir}/${f}.new."* 2>/dev/null || true; done
    if differs "${src}/styrman-update" "${bin}"; then
        if atomic_install 755 "${src}/styrman-update" "${bin}"; then changed=1; else failed=1; log "WARN: could not self-install ${bin}"; fi
    fi
    for f in "${units[@]}"; do
        if differs "${src}/${f}" "${unitdir}/${f}"; then
            # Keep going on a failure: a partially updated pair still needs the
            # daemon-reload below for whatever DID land (review).
            if atomic_install 644 "${src}/${f}" "${unitdir}/${f}"; then changed=1; else failed=1; log "WARN: could not self-install ${unitdir}/${f}"; fi
        fi
    done
    if [ "${changed}" = "1" ]; then
        # Re-read units now; the new script/units apply on the next run. Not
        # fatal: a deploy already health-checked must not be reported failed
        # because of this housekeeping.
        local out
        if ! out="$(systemctl daemon-reload 2>&1)"; then
            log "WARN: systemctl daemon-reload failed after self-install: ${out}"
        fi
    fi
    if [ "${failed}" = "0" ]; then
        [ "${changed}" = "1" ] && log "updater self-installed from the verified tree (takes effect next run)"
    else
        log "WARN: self-install incomplete — the next run may still use the previous updater"
    fi
    return 0
}

# ─── Host converge (ADR-065) ────────────────────────────────────────────────
# The firewall script and its units live OUTSIDE the container stack, and
# until ADR-065 nothing delivered a change to them: this host ran a 2026-08-30
# script for a week after the repo grew two DROPs. On EVERY tick — before the
# "already up to date" exit as well as after a deploy or rollback — install
# deploy/firewall/{styrman-firewall.sh,.service,.timer,.path} from the
# VERIFIED git object when they differ from what is installed. Gate: signature
# enforcement on, the targets unit-pinned (ADR-052), and HEAD equal to the SHA
# this host recorded when the deployed tag verified — a hand-checked-out clone
# is skipped, and says so on every tick rather than once. It never touches
# /etc/styrman/firewall.conf or the tmpfiles entry: what "local network" means
# stays the operator's one-time decision (deploy/firewall/install.sh).
FW_INSTALL_BIN="${STYRMAN_FW_INSTALL_BIN:-}"
host_converge() {
    if [ -z "${FW_INSTALL_BIN}" ] || [ -z "${UPDATER_UNIT_DIR}" ]; then
        log "host-converge skipped: STYRMAN_FW_INSTALL_BIN/STYRMAN_UPDATER_UNIT_DIR unset (the unit sets them)"
        return 0
    fi
    if [ "${REQUIRE_SIGNED}" != "1" ]; then
        log "WARN: host-converge skipped: signature enforcement is OFF — an unverified tree must not become root's firewall script"
        return 0
    fi
    local bin bindir unitdir head want src changed=0 failed=0 f out
    bin="$(realpath -m -- "${FW_INSTALL_BIN}")"; bindir="$(dirname "${bin}")"
    unitdir="$(realpath -m -- "${UPDATER_UNIT_DIR}")"
    if [ "$(basename "${bin}")" != "styrman-firewall.sh" ]; then
        log "WARN: host-converge skipped: STYRMAN_FW_INSTALL_BIN must be named styrman-firewall.sh (got ${bin})"; return 0
    fi
    if ! trusted_dir "${bindir}" || ! trusted_dir "${unitdir}"; then
        log "WARN: host-converge skipped: ${bindir} or ${unitdir} is missing, not root-owned, or group/world-writable"; return 0
    fi
    want="$(cat "${STATE_SHA}" 2>/dev/null || true)"
    if ! printf '%s' "${want}" | grep -qE '^[0-9a-f]{40}$'; then
        log "WARN: host-converge skipped: no verified deployed-sha in ${STATE_DIR} — deploy a signed tag first (or run deploy/firewall/install.sh by hand)"; return 0
    fi
    head="$(git rev-parse HEAD 2>/dev/null)" || { log "WARN: host-converge skipped: cannot resolve HEAD"; return 0; }
    if [ "${head}" != "${want}" ]; then
        log "WARN: host-converge skipped: ${DEPLOY_DIR} is at ${head:0:12}, not the verified deployed commit ${want:0:12}"; return 0
    fi
    SELF_HEAD="${head}"
    src="deploy/firewall"
    for f in styrman-firewall.sh styrman-firewall.service styrman-firewall.timer; do
        git cat-file -e "${SELF_HEAD}:${src}/${f}" 2>/dev/null || { log "host-converge: ${src}/${f} not in the deployed tree (pre-ADR-065 release) — skipped"; return 0; }
    done
    # ADR-067 deleted styrman-firewall.path. A host upgrading across that
    # release still has the unit installed; removing it is install.sh's job
    # (host-setup.sh), not the updater's — the updater only ever installs the
    # files the verified tree carries. A leftover .path unit watching a
    # directory nothing writes is inert.
    # The harness channel's unit pair (ADR-073), on EVERY tick from the
    # verified tree, exactly like the firewall files: self_install carries
    # them too, but self_install runs only on the tick that deploys a
    # release, and that tick executes the PREVIOUS updater, which does not
    # know them — the release that ships a file cannot be the one that
    # installs it (BUG-035's shape, BUG-064). Optional: a tree without them
    # is a pre-ADR-073 release. Under --check: drift reported, nothing
    # installed, like the firewall files below.
    local hf hn=0 hchanged=0 hunits=()
    for hf in styrman-harness-update.service styrman-harness-update.timer; do
        git cat-file -e "${SELF_HEAD}:deploy/update/${hf}" 2>/dev/null && hunits+=("${hf}")
    done
    if [ "${#hunits[@]}" = 2 ]; then
        # Orphans of a SIGKILLed attempt are swept for both targets up front,
        # not only for the one that drifts this run (as self_install does).
        [ "${CHECK_ONLY}" = true ] || for hf in "${hunits[@]}"; do rm -f "${unitdir}/${hf}.new."* 2>/dev/null || true; done
        for hf in "${hunits[@]}"; do
            differs "deploy/update/${hf}" "${unitdir}/${hf}" || continue
            if [ "${CHECK_ONLY}" = true ]; then hn=$((hn + 1)); continue; fi
            if atomic_install 644 "deploy/update/${hf}" "${unitdir}/${hf}"; then hchanged=1; else failed=1; log "WARN: could not install ${unitdir}/${hf}"; fi
        done
        if [ "${hn}" -gt 0 ]; then log "host-converge: ${hn} harness-channel unit(s) differ from the verified tree — a real run would install them (--check changes nothing)"; fi
        if [ "${hchanged}" = "1" ]; then
            if ! out="$(systemctl daemon-reload 2>&1)"; then log "WARN: daemon-reload after installing the harness-channel units: ${out}"; fi
            log "host-converge: harness-channel units installed from ${SELF_HEAD:0:12} (enabled below once the clone exists)"
        fi
    fi
    # --check promises to change nothing (usage text above): report drift,
    # install nothing (review finding — the very drift this exists to fix is
    # when a preview run would otherwise silently apply it).
    if [ "${CHECK_ONLY}" = true ]; then
        local n=0
        differs "${src}/styrman-firewall.sh" "${bin}" && n=$((n + 1))
        for f in styrman-firewall.service styrman-firewall.timer; do
            differs "${src}/${f}" "${unitdir}/${f}" && n=$((n + 1))
        done
        if [ "${n}" -gt 0 ]; then log "host-converge: ${n} firewall file(s) differ from the verified tree — a real run would install them (--check changes nothing)"; fi
        return 0
    fi
    rm -f "${bin}.new."* "${unitdir}/styrman-firewall.service.new."* "${unitdir}/styrman-firewall.timer.new."* 2>/dev/null || true
    if differs "${src}/styrman-firewall.sh" "${bin}"; then
        if atomic_install 755 "${src}/styrman-firewall.sh" "${bin}"; then changed=1; else failed=1; log "WARN: could not install ${bin}"; fi
    fi
    for f in styrman-firewall.service styrman-firewall.timer; do
        if differs "${src}/${f}" "${unitdir}/${f}"; then
            if atomic_install 644 "${src}/${f}" "${unitdir}/${f}"; then changed=1; else failed=1; log "WARN: could not install ${unitdir}/${f}"; fi
        fi
    done
    if [ "${changed}" = "1" ]; then
        if ! out="$(systemctl daemon-reload 2>&1)"; then log "WARN: daemon-reload after host-converge: ${out}"; fi
        if ! out="$(systemctl enable --now styrman-firewall.timer 2>&1)"; then log "WARN: enabling the firewall units: ${out}"; fi
        if ! out="$(systemctl start styrman-firewall.service 2>&1)"; then log "WARN: starting styrman-firewall.service: ${out}"; fi
        log "host-converge: firewall script + units installed from ${SELF_HEAD:0:12} (see journalctl -u styrman-firewall)"
    fi
    # The service is a boot-time unit too (its [Install] section): the base
    # rules land once right after docker.service, not at the timer's first
    # tick (ADR-065 follow-up (f), closed 2026-09-10). Enabled on EVERY tick,
    # not only when a unit file changed: the v1.27.0 tick that installed the
    # new unit ran the previous updater (which had no enable), and the next
    # tick saw nothing changed — so the unit stayed disabled until the
    # operator's install.sh. `systemctl enable` is idempotent and cheap.
    if ! out="$(systemctl enable styrman-firewall.service 2>&1)"; then log "WARN: enabling styrman-firewall.service at boot: ${out}"; fi
    # The harness channel's timer (ADR-073), unconditionally once its unit and
    # its clone exist (BUG-035: a step gated on "changed this tick" never sees
    # the release that ships it). Without the clone the tick would only fail
    # — `styrman-ctl update --setup --harness-token-file` makes both.
    # The clone's path comes from the crew unit (ADR-052: pinned there, never
    # defaulted here); a unit from before this release leaves it unset, and
    # the enable waits one tick for self_install to bring the unit current.
    if [ -f "${unitdir}/styrman-harness-update.timer" ] && [ -n "${STYRMAN_HARNESS_REPO_DIR:-}" ] && [ -d "${STYRMAN_HARNESS_REPO_DIR}/.git" ]; then
        if ! out="$(systemctl enable --now styrman-harness-update.timer 2>&1)"; then log "WARN: enabling styrman-harness-update.timer: ${out}"; fi
    fi
    [ "${failed}" = "0" ] || log "WARN: host-converge incomplete — the previous firewall script may still be installed"
    return 0
}

# ─── Deploy ─────────────────────────────────────────────────────────────────
# deploy <tag> — checkout, rebuild both images, bring the stack up.
# deploy <ref> <version> [trusted]
#   ref      what to check out — a tag, or a commit SHA on the rollback path
#   version  the version string to stamp (a SHA carries none of its own)
#   trusted  "trusted" skips verification. Used ONLY for a rollback to the
#            recorded SHA of a deploy this host already verified and ran; every
#            other path verifies. Rolling back by SHA is what makes the rollback
#            work at all: re-verifying the old TAG fails for every release made
#            before signing was adopted (v1.14.0-v1.15.0 here), and `git fetch
#            --tags --force` would accept a re-pointed tag anyway.
deploy() {
    local ref="$1" ver="$2" trusted="${3:-}"
    if [ "${trusted}" != "trusted" ]; then
        verify_tag "${ref}" || return 1
    else
        log "rolling back to a previously verified tree (${ref})"
    fi
    log "deploying ${ref} as ${ver}"
    git checkout --detach --force "${ref}" 2>/dev/null || { log "checkout ${ref} failed"; return 1; }
    # --force replaces TRACKED files but leaves untracked ones, and the server
    # image builds with `context: ..` — so a planted file would survive every
    # checkout into every image. `-d` without `-x` deliberately keeps ignored
    # files: deploy/.env is gitignored and must NOT be deleted.
    git clean -d --force --quiet || log "WARN: git clean failed"

    local runtime_image="styrman-runtime:${ver}"
    log "building runtime image (${runtime_image})"
    docker build -t "${runtime_image}" --build-arg "STYRMAN_VERSION=${ver}" "${DEPLOY_DIR}/image" \
        || return 1

    # Build EVERY compose service, not just styrman: the vendored Caddy ingress
    # is also built from this checkout, and `up -d` alone would leave a tag that
    # changes deploy/caddy/** shipping everything except the ingress — while
    # still reporting VERIFIED (review finding).
    # STYRMAN_IMAGE is passed explicitly: shell env outranks the clone's
    # deploy/.env in compose precedence, so a stale STYRMAN_IMAGE line left in
    # that file can never re-point projects at a mutable tag.
    log "building + starting the stack (server + ingress) at ${ver}"
    ( cd "${DEPLOY_DIR}/deploy" \
      && STYRMAN_VERSION="${ver}" STYRMAN_IMAGE="${runtime_image}" docker compose -f docker-compose.yml build \
      && STYRMAN_VERSION="${ver}" STYRMAN_IMAGE="${runtime_image}" docker compose -f docker-compose.yml up -d ) || return 1
}

# reports_version <x.y.z> — wait until the RUNNING server container is healthy
# and carries this version.
#
# Read from the container, not the HTTP API. The obvious implementation —
# polling /api/version — needed an identity header, and production runs
# STYRMAN_AUTH=header where authGuard exempts only /api/health, so a synthetic
# "updater@localhost" got 403 forever: every HEALTHY release would have timed
# out, rolled back, and latched its tag as failed (review finding). The label
# is stamped at build time (deploy/Dockerfile.server) and needs no auth, no
# ingress token, and no network.
#
# Fails CLOSED: any inability to confirm the version is a failure, because the
# caller uses this to decide whether to keep the release or roll it back.
reports_version() {
    local want="$1" deadline got health running
    got=""; health=""; running=""   # set -u: the loop may never execute
    deadline=$(( $(date +%s) + HEALTH_TIMEOUT ))
    while [ "$(date +%s)" -lt "${deadline}" ]; do
        got="$(docker inspect styrman-server \
              --format '{{index .Config.Labels "styrman.version"}}' 2>/dev/null || true)"
        # No healthcheck defined = "<no value>"; treat only an explicit
        # "unhealthy"/"starting" as not-ready.
        health="$(docker inspect styrman-server \
                 --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' 2>/dev/null || true)"
        running="$(docker inspect styrman-server --format '{{.State.Running}}' 2>/dev/null || true)"
        # An EMPTY label is never a match: an image built before version
        # labelling existed would otherwise compare equal to an empty want and
        # verify anything. (My own first test of this function passed for
        # exactly that reason.)
        # Must be RUNNING. "none" (no healthcheck defined) is accepted only
        # because a tag could legitimately drop the HEALTHCHECK line — but a
        # dead container must never verify, which "none" alone allowed.
        if [ -n "${got}" ] && [ "${got}" = "${want}" ] && [ "${running}" = "true" ] &&
           { [ "${health}" = "healthy" ] || [ "${health}" = "none" ]; }; then
            return 0
        fi
        sleep 5
    done
    if [ -z "${got}" ]; then
        log "version check failed: styrman-server carries NO styrman.version label."
        log "  An image built before labelling cannot be verified. Confirm by hand"
        log "  and re-run with --force once the running version is known-good."
    else
        log "version check failed: label=${got} want=${want} running=${running:-?} health=${health:-<none>}"
    fi
    return 1
}

# ─── Every-tick host converge, then the early exits ─────────────────────────
# Converge FIRST: the deployed tree's firewall half must be kept installed
# whatever this tick decides about a new tag — even while a broken release
# stays latched as FAILED (review finding). Under --check it only reports.
host_converge
# A previously failed tag is not retried automatically — only --force (or a
# newer tag) gets past this. Retrying a known-broken release on every tick
# would rebuild both images every few minutes and churn the live server.
if [ "$(cat "${FAILED}" 2>/dev/null || true)" = "${LATEST}" ] && [ "${FORCE}" = false ]; then
    log "${LATEST} previously FAILED to deploy and was rolled back — skipping."
    log "  investigate, then re-run with --force (or push a newer tag)."
    exit 0
fi
if [ "${FORCE}" = true ]; then
    rm -f "${FAILED}"
fi

if [ "${CURRENT}" = "${LATEST}" ] && [ "${FORCE}" = false ]; then
    log "already up to date"
    exit 0
fi
if [ "${CHECK_ONLY}" = true ]; then
    log "update AVAILABLE: ${CURRENT} → ${LATEST}"
    git --no-pager log --oneline "${CURRENT}..${LATEST}" 2>/dev/null | head -20 || true
    exit 0
fi

PREVIOUS="${CURRENT}"
PREVIOUS_SHA="$(cat "${STATE_SHA}" 2>/dev/null || true)"
# Only a full 40-hex object name is usable as a rollback ref.
printf '%s' "${PREVIOUS_SHA}" | grep -qE '^[0-9a-f]{40}$' || PREVIOUS_SHA=""

if deploy "${LATEST}" "${LATEST#v}" && reports_version "${LATEST#v}"; then
    printf '%s' "${LATEST}" > "${STATE}"
    # Only record a trusted SHA when it was actually verified — otherwise a SHA
    # captured during an opt-out window would keep skipping verification after
    # signing is re-enabled (security review).
    if [ "${REQUIRE_SIGNED}" = "1" ]; then
        git rev-parse "${LATEST}^{commit}" > "${STATE_SHA}" 2>/dev/null || true
    else
        rm -f "${STATE_SHA}"
    fi
    rm -f "${FAILED}"
    self_install
    host_converge
    log "OK — ${LATEST} is live"
    exit 0
fi

# ─── Rollback ───────────────────────────────────────────────────────────────
log "ERROR: ${LATEST} did not come up healthy within ${HEALTH_TIMEOUT}s"
# Latch BEFORE deciding what to do about it: on a first run there is no
# previous version to roll back to, and without the latch the timer would
# rebuild this same broken tag every 5 minutes forever (review finding).
printf '%s' "${LATEST}" > "${FAILED}"
if [ "${PREVIOUS}" = "none" ] || [ -z "${PREVIOUS}" ]; then
    fail "no previous version recorded — leaving the box as-is for manual repair. ${LATEST} is latched as failed; re-run with --force after fixing."
fi
log "rolling back to ${PREVIOUS}"
# Prefer the recorded SHA (already verified when it was deployed); fall back to
# the tag only when no SHA was recorded — e.g. the first run after adopting it.
if [ -n "${PREVIOUS_SHA}" ]; then
    rollback_ref="${PREVIOUS_SHA}"; rollback_trust="trusted"
else
    log "no recorded commit for ${PREVIOUS} — falling back to the tag, which must verify"
    rollback_ref="${PREVIOUS}"; rollback_trust=""
fi
if deploy "${rollback_ref}" "${PREVIOUS#v}" "${rollback_trust}" && reports_version "${PREVIOUS#v}"; then
    printf '%s' "${PREVIOUS}" > "${STATE}"
    # The updater must match what is DEPLOYED, so the rolled-back tree's
    # copies are installed too (this run keeps executing the old inode).
    self_install
    host_converge
    fail "rolled back to ${PREVIOUS}. ${LATEST} is marked FAILED and will not be retried automatically — fix it and re-run with --force, or push a newer tag."
fi
fail "rollback to ${PREVIOUS} ALSO failed — manual intervention required"
