[Unit]
Description=styrman tag-gated auto-update (newest stable vX.Y.Z tag)
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
# The ONLY place the production state path is pinned (ADR-052): the script has
# no default, so a bare invocation — notably a privileged TEST run — can never
# alias production state by omission.
Environment=STYRMAN_UPDATE_STATE_DIR=/etc/styrman/update
# The docker CLI insists on creating $DOCKER_CONFIG (/root/.docker by default)
# and ProtectHome=yes (below) makes /root INACCESSIBLE and empty — which killed
# the first real end-to-end deploy at `docker build`, and its rollback with it
# (2026-09-01). A per-run, systemd-managed tmpfs dir: wiped after the oneshot,
# so no root-executed docker config, cli-plugins or buildx state accretes
# anywhere (code review 2026-09-02: the earlier fix parked it under the
# trust-asserted state dir, unasserted and re-pinning the path). Hand-runs get
# the same shape from the script itself (a mktemp dir removed on exit).
RuntimeDirectory=styrman-update
RuntimeDirectoryMode=0700
Environment=DOCKER_CONFIG=%t/styrman-update/docker
ExecStart=/usr/local/bin/styrman-update
# Builds are heavy and must never starve the running platform.
Nice=10
IOSchedulingClass=idle
# A build can legitimately take many minutes; the flock in the script is what
# prevents overlap, so give it room rather than killing a half-built image.
TimeoutStartSec=45min
# Modest hardening. Be honest about what it buys: the real control is the tag
# SIGNATURE check in the script, because a hostile release's payload runs in
# the DOCKER DAEMON, not in this cgroup — sandboxing this unit cannot contain
# it (security review, 2026-09-01). These are free, so they stay.
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
