#!/usr/bin/env bash
# styrman git credential helper (ADR-030). git calls this on `get`; it pulls
# the current token from the credential broker on the project's own bridge —
# no token is stored in the project. The broker URL is the fixed per-bridge
# address delivered as $STYRMAN_CRED_BROKER (container env; same URL from
# every project).
#
# git protocol: reads key=value lines on stdin (protocol/host/path/...),
# writes username=/password= on stdout for `get`. store/erase are no-ops
# (the broker owns the credential; nothing persists here).
set -eu

[ "${1:-}" = "get" ] || exit 0
[ -n "${STYRMAN_CRED_BROKER:-}" ] || exit 0   # broker off → git tries other helpers

# Collect the fields git sends.
host=""
while IFS='=' read -r key val; do
    [ -z "${key}" ] && break
    [ "${key}" = "host" ] && host="${val}"
done
# Only sane hostnames reach the broker query (defensive; host comes from the
# git remote). Anything else → fall through.
case "${host}" in
    ''|*[!A-Za-z0-9.-]*) exit 0 ;;
esac

# Ask the broker for this host's credential; stay quiet/fast on any failure.
resp="$(curl -fsS --max-time 5 "${STYRMAN_CRED_BROKER}/git?host=${host}" 2>/dev/null || true)"
[ -n "${resp}" ] || exit 0

# Minimal JSON field extraction (avoids a jq dependency in the hot path).
username="$(printf '%s' "${resp}" | sed -n 's/.*"username"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
token="$(printf '%s' "${resp}" | sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
[ -n "${token}" ] || exit 0

printf 'username=%s\n' "${username:-x-access-token}"
printf 'password=%s\n' "${token}"
