#!/usr/bin/env bash
# styrman-browser — ONE headless Chromium per project microVM (ADR-068).
#
# Runs as the project user. The operator drives it from the SPA's Browser
# view (a CDP screencast relayed by the styrman server); the agents drive the
# SAME browser through chrome-devtools-mcp (the `mcp` verb, registered for
# claude and agy at harness seeding). Chromium's DevTools listener binds
# LOOPBACK ONLY (new-headless ignores --remote-debugging-address, verified
# 2026-09-11), on CHROME_PORT — that is what in-guest clients (the MCP verb)
# use. For the styrman server, which reaches the guest over the project
# bridge, a socat forwarder (its own process group) publishes it as :9222 —
# and admits ONE peer address: the server's own address on this bridge,
# which the server passes as STYRMAN_BROWSER_PEER on every `start` (falling
# back to the credential broker's host from STYRMAN_CRED_BROKER, the same
# address in a containerized deploy). No peer, no forwarder: the browser
# stays loopback-only and the Browser pane cannot connect — it fails closed
# rather than guessing (security review, 2026-09-11). A container the user
# runs inside this project's dockerd can reach the guest's bridge IP but is
# refused by socat's `range=` — a DevTools client reads file:// inside the
# guest, i.e. the brokered credentials, and an image the user merely runs
# must not gain that. The server never lists, proxies or shares the port.
#
#   styrman-browser start    idempotent; 0 once /json/version answers (≤ 15 s), else 1 + the log tail
#   styrman-browser stop     kills the process group; 0 even when nothing runs
#   styrman-browser status   {"running":true,"version":"Chrome/…"} | {"running":false}
#   styrman-browser mcp      start (quiet), then exec chrome-devtools-mcp on this browser (stdio, loopback)
#
# Why no --remote-allow-origins: Chromium's DevTools server refuses a
# WebSocket upgrade whose Origin header is not on its allowlist, and the
# allowlist is empty on purpose. Our two clients — the styrman server's relay
# and chrome-devtools-mcp — send NO Origin header and are admitted; a page
# RENDERED INSIDE this browser always sends one and is refused, which is
# exactly the takeover (file:// reads, cookies, every tab) the flag would
# have allowed (review finding, 2026-09-11).
#
# Why no --no-sandbox: probed 2026-09-11 inside a real Kata mvm guest
# (kernel 6.18, user namespaces on) — Chromium's own sandbox works there. If a
# future image or kernel breaks it, `start` fails LOUDLY (the log tail reaches
# the pane) rather than silently weakening the sandbox.
set -euo pipefail

PORT=9222        # the styrman server's door: socat, bridge address, one allowed peer
CHROME_PORT=9229 # Chromium's own loopback-only DevTools listener: in-guest clients
HOME="${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)}"
DIR="${HOME}/.styrman/browser"
PROFILE="${DIR}/profile"
PIDFILE="${DIR}/pid"
SOCATPID="${DIR}/socat.pid"
LOG="${DIR}/chromium.log"
LOCK="${DIR}/lock"
VERSION_URL="http://127.0.0.1:${CHROME_PORT}/json/version"

# /json/version's body, or failure. Chromium refuses a Host header that is
# not localhost or an IP literal, which 127.0.0.1 satisfies.
probe() { curl -fsS --max-time 2 "${VERSION_URL}" 2>/dev/null; }
version_of() { probe | jq -r '.Browser // empty' 2>/dev/null || true; }

# The one source address socat admits on :9222, as "<ip>/32", or "" when
# there is none (then no forwarder runs and the browser stays loopback-only:
# the MCP verb still works, the Browser pane cannot connect). Only an IPv4
# literal is accepted: the value lands inside socat's option list, where a
# stray comma would read as more options (security review).
peer_range() {
    local host=""
    if [ -n "${STYRMAN_BROWSER_PEER:-}" ]; then
        host="${STYRMAN_BROWSER_PEER}"
    elif [ -n "${STYRMAN_CRED_BROKER:-}" ]; then
        host="${STYRMAN_CRED_BROKER#*://}"
        host="${host%%/*}"
        host="${host%%:*}"
    fi
    if printf '%s' "${host}" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
        printf '%s/32' "${host}"
    fi
    return 0
}

forwarder_up() { ss -ltnH 2>/dev/null | grep -q ":${PORT} "; }

# The forwarder is its own process group with its own pid file, so it can be
# started AFTER Chromium: a browser the agent's MCP server started (no peer in
# its environment) gains the server's door when the pane's `start` arrives
# with STYRMAN_BROWSER_PEER set.
ensure_forwarder() {
    local range
    range="$(peer_range)"
    if [ -z "${range}" ]; then
        echo "no peer address for :${PORT} (STYRMAN_BROWSER_PEER unset): browser stays loopback-only" >&2
        return 0
    fi
    forwarder_up && return 0
    # shellcheck disable=SC2016  # the $-expressions belong to the inner bash
    setsid -f bash -c 'echo $$ > "$1"; exec socat "TCP-LISTEN:$2,fork,reuseaddr,bind=0.0.0.0,range=$3,max-children=4" "TCP:127.0.0.1:$4"' \
        _ "${SOCATPID}" "${PORT}" "${range}" "${CHROME_PORT}" 9>&- >>"${LOG}" 2>&1
    local _i
    for _i in $(seq 1 10); do
        forwarder_up && return 0
        sleep 0.2
    done
    echo "forwarder did not come up on :${PORT}" >&2
    return 1
}

# Every path below is under the guest-writable home and is created BY NAME
# as the same uid that owns the home — no privilege boundary is crossed, so
# a planted link here can only hurt its planter. Links are still refused,
# because `: > LOG` through one would truncate whatever it points at (the
# transcripts under ~/.styrman/logs are what the SERVER reads back). Checked
# BEFORE anything is created, ~/.styrman included.
refuse_links() {
    local p
    for p in "${HOME}/.styrman" "${DIR}" "${PROFILE}" "${LOG}" "${PIDFILE}" "${SOCATPID}" "${LOCK}"; do
        if [ -L "${p}" ]; then
            echo "refusing to use ${p}: it is a symlink"
            return 1
        fi
    done
}

launch() {
    refuse_links || return 1
    mkdir -p "${DIR}" "${PROFILE}"
    chmod 700 "${DIR}"
    # A crashed run leaves the profile's singleton lock behind; Chromium then
    # refuses the profile and exits. Only safe when nothing answers — which
    # the caller has just checked under the lock.
    rm -f "${PROFILE}/SingletonLock" "${PROFILE}/SingletonSocket" "${PROFILE}/SingletonCookie" "${PIDFILE}"
    : > "${LOG}"
    # setsid: its own session and process group, so `stop` can kill the whole
    # tree by group; -f forks so this script returns. The pid file holds the
    # group leader (bash's $$ becomes chromium's pid through exec). 9>&-
    # closes the lock descriptor in the child: inherited, chromium would hold
    # the start lock for its whole life and the NEXT start would block on it
    # forever (seen 2026-09-11 in the Kata probe).
    # shellcheck disable=SC2016  # the $-expressions belong to the inner bash
    setsid -f bash -c 'echo $$ > "$1"; \
        exec chromium \
        --headless=new \
        --remote-debugging-port="$3" \
        --user-data-dir="$2" \
        --window-size=1280,800 \
        --no-first-run --no-default-browser-check \
        --disable-gpu --disable-dev-shm-usage \
        about:blank' _ "${PIDFILE}" "${PROFILE}" "${CHROME_PORT}" 9>&- >"${LOG}" 2>&1
}

do_start() {
    refuse_links || return 1
    mkdir -p "${DIR}"
    chmod 700 "${DIR}"
    # The SPA relay and the agent's MCP server may start it at the same
    # moment: serialize probe-then-launch.
    exec 9>"${LOCK}"
    # Bounded: a holder that never releases (a bug like the one above) must
    # surface as a failure, not a hang the server's 30 s exec cap has to cut.
    flock -w 20 9 || { echo "another start is holding ${LOCK} for over 20 s"; return 1; }
    if probe >/dev/null; then
        ensure_forwarder
        return $?
    fi
    launch
    for _ in $(seq 1 30); do
        sleep 0.5
        if probe >/dev/null; then
            ensure_forwarder
            return $?
        fi
    done
    echo "chromium did not answer on :${CHROME_PORT} within 15 s; last log lines:"
    # dbus is absent in the guest by design (ADR-040); its errors are noise.
    grep -v dbus "${LOG}" | tail -20 || true
    # A failed launch can leave orphaned renderer/zygote children behind
    # (seen when the sandbox is refused): take the whole group down.
    do_stop
    return 1
}

kill_group_file() {
    local f="$1" pid
    if [ -f "${f}" ]; then
        pid="$(cat "${f}" 2>/dev/null || true)"
        # Signal the GROUP, not the leader: chromium's children share the
        # group setsid created, and they outlive a leader that crashed.
        if [ -n "${pid}" ]; then
            kill -TERM -- "-${pid}" 2>/dev/null || true
            for _ in $(seq 1 10); do
                pgrep -g "${pid}" >/dev/null 2>&1 || break
                sleep 0.5
            done
            kill -KILL -- "-${pid}" 2>/dev/null || true
        fi
        rm -f "${f}"
    fi
}

do_stop() {
    kill_group_file "${SOCATPID}"
    kill_group_file "${PIDFILE}"
    return 0
}

do_status() {
    v="$(version_of)"
    if [ -n "${v}" ]; then
        jq -cn --arg v "${v}" '{running:true,version:$v}'
    else
        echo '{"running":false}'
    fi
}

do_mcp() {
    # stdout is the MCP stdio channel: nothing but the server may write to it.
    if ! do_start >&2; then
        echo "styrman-browser: the browser did not start" >&2
        exit 1
    fi
    exec chrome-devtools-mcp --browserUrl "http://127.0.0.1:${CHROME_PORT}"
}

case "${1:-}" in
    start)  do_start ;;
    stop)   do_stop ;;
    status) do_status ;;
    mcp)    do_mcp ;;
    *) echo "usage: styrman-browser start|stop|status|mcp" >&2; exit 2 ;;
esac
