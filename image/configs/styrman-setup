#!/usr/bin/env bash
# styrman-setup — one-time-per-user onboarding, run in the first-run setup VM
# (also re-runnable in any project to check status or sign in to more tools).
# REQUIRED: git identity + ssh key. Everything else (GitHub, Google Cloud,
# Claude, Antigravity) is OPTIONAL — skip it and rerun styrman-setup whenever.
# Finishing setup harvests whatever is signed in into the broker, which keeps
# every project current automatically (R3/ADR-032/ADR-034). Idempotent.
set -uo pipefail

BOLD=$'\033[1m'; DIM=$'\033[2m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RESET=$'\033[0m'
ok()   { echo "  ${GREEN}✔${RESET} $*"; }
todo() { echo "  ${YELLOW}➜${RESET} $*"; }
step() { echo; echo "${BOLD}$*${RESET}"; }
# ask_optional PROMPT → 0 if the user says yes. Non-interactive (a harvest or a
# piped run) always skips, so it never blocks.
ask_optional() {
    [ -t 0 ] || return 1
    local ans; read -rp "  ${1} [y/N] " ans
    case "${ans}" in [yY]*) return 0 ;; *) return 1 ;; esac
}

echo "${BOLD}styrman setup — sign in once, use everywhere${RESET}"
echo "${DIM}Required: git identity + ssh key. GitHub, Google Cloud, Claude and"
echo "agy are optional — skip any of them and rerun styrman-setup later.${RESET}"

step "Required · Git identity"
if git config --global user.email >/dev/null 2>&1; then
    ok "git: $(git config --global user.name) <$(git config --global user.email)>"
else
    todo "no git identity yet"
    GIT_NAME=""; GIT_EMAIL=""
    # Loop until both are non-empty. Under a non-interactive exec, read returns
    # immediately with empty values — bail with guidance instead of saving an
    # empty identity that makes every commit fail (N32).
    while [ -z "${GIT_NAME}" ] || [ -z "${GIT_EMAIL}" ]; do
        [ -t 0 ] || { todo "run styrman-setup in an interactive terminal to set git identity"; break; }
        [ -z "${GIT_NAME}" ]  && read -rp "  your name: "  GIT_NAME
        [ -z "${GIT_EMAIL}" ] && read -rp "  your email: " GIT_EMAIL
    done
    if [ -n "${GIT_NAME}" ] && [ -n "${GIT_EMAIL}" ]; then
        git config --global user.name "${GIT_NAME}"
        git config --global user.email "${GIT_EMAIL}"
        git config --global init.defaultBranch main
        ok "git identity saved to ~/.gitconfig"
    fi
fi

step "Required · SSH key (for git over ssh)"
# The key is YOURS — comment it with your identity, not the platform's.
KEY_COMMENT="$(git config --global user.email 2>/dev/null || true)"
[ -n "${KEY_COMMENT}" ] || KEY_COMMENT="$(whoami)@styrman"
if [ -f ~/.ssh/id_ed25519 ]; then
    CURRENT_COMMENT=$(ssh-keygen -l -f ~/.ssh/id_ed25519.pub 2>/dev/null | sed -E 's/^[0-9]+ [^ ]+ //; s/ \([A-Z0-9]+\)$//')
    if [ "${CURRENT_COMMENT}" = "styrman" ]; then
        if ssh-keygen -c -C "${KEY_COMMENT}" -f ~/.ssh/id_ed25519 >/dev/null 2>&1; then
            ok "key comment updated to ${KEY_COMMENT}"
        else
            todo "could not update key comment (passphrase-protected?) — key kept as-is"
        fi
    else
        ok "key exists: ~/.ssh/id_ed25519 (${CURRENT_COMMENT})"
    fi
else
    ssh-keygen -t ed25519 -N "" -C "${KEY_COMMENT}" -f ~/.ssh/id_ed25519 >/dev/null
    ok "generated ~/.ssh/id_ed25519 (${KEY_COMMENT})"
fi
echo "  public key (add to https://github.com/settings/keys if not done):"
echo "    $(cat ~/.ssh/id_ed25519.pub)"

step "Optional · GitHub CLI (gh)"
if gh auth status >/dev/null 2>&1; then
    ok "gh: logged in as $(gh api user --jq .login 2>/dev/null || echo '?')"
elif ask_optional "sign in to GitHub now?"; then
    todo "A one-time code and a URL appear below — CLICK the URL, enter the code, authorize."
    gh auth login --hostname github.com --git-protocol ssh --web \
        || todo "gh login skipped/failed — rerun styrman-setup anytime"
else
    todo "skipped — rerun styrman-setup anytime"
fi

step "Optional · Google Cloud (gcloud)"
if ! command -v gcloud >/dev/null 2>&1; then
    todo "gcloud not installed in this project — skipping"
else
    GACCT="$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null | head -1)"
    if [ -n "${GACCT}" ]; then
        ok "gcloud account: ${GACCT}"
    elif ask_optional "sign in to Google Cloud (gcloud auth login) now?"; then
        todo "gcloud prints a URL — CLICK it, approve, paste the verification code back."
        gcloud auth login --no-launch-browser \
            || todo "gcloud login skipped/failed — rerun styrman-setup anytime"
    else
        todo "gcloud account skipped — rerun styrman-setup anytime"
    fi
    # Application Default Credentials — separate from the account; this is what
    # terraform and the client libraries use, and what the broker syncs.
    if gcloud auth application-default print-access-token >/dev/null 2>&1; then
        ok "gcloud ADC: present (terraform + client libraries)"
    elif ask_optional "set up Application Default Credentials (gcloud auth application-default login) now?"; then
        todo "another URL appears — CLICK it, approve, paste the code back."
        gcloud auth application-default login --no-launch-browser \
            || todo "ADC login skipped/failed — rerun styrman-setup anytime"
    else
        todo "ADC skipped — rerun styrman-setup anytime"
    fi
fi

step "Optional · Claude Code"
if [ -f ~/.claude/.credentials.json ] || claude auth status 2>/dev/null | grep -qi 'logged in'; then
    ok "claude: credentials present (~/.claude)"
elif ask_optional "sign in to Claude now?"; then
    todo "claude prints a sign-in URL — CLICK it, approve, paste the code back; /exit when done."
    claude || true
else
    todo "skipped — rerun styrman-setup anytime"
fi

step "Optional · Antigravity CLI (agy)"
if [ -f ~/.gemini/antigravity-cli/antigravity-oauth-token ]; then
    ok "agy: credentials present"
elif ask_optional "sign in to Antigravity (agy) now?"; then
    todo "agy prints a Google sign-in URL — CLICK it, approve, paste the code back, then quit agy."
    agy || true
else
    todo "skipped — rerun styrman-setup anytime"
fi

step "Done"
echo "Git and ssh are set up; any optional tools you signed in to are shared with"
echo "every project — current and future — automatically through the broker."
echo "Rerun ${BOLD}styrman-setup${RESET} anytime to check status or sign in to the rest;"
echo "${BOLD}Settings → Credentials${RESET} shows what's shared and can re-import."
